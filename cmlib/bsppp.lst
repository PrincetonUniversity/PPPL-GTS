     %%%    L o o p m a r k   L e g e n d    %%%

     Primary Loop Type        Modifiers
     ------- ---- ----        ---------
     A - Pattern matched      a - atomic memory operation
                              b - blocked
     C - Collapsed            c - conditional and/or computed
     D - Deleted               
     E - Cloned               f - fused
     G - Accelerated          g - partitioned
     I - Inlined              i - interchanged
     M - Multithreaded        m - partitioned
                              n - non-blocking remote transfer
                              p - partial
                              r - unrolled
                              s - shortloop
     V - Vectorized           w - unwound


    1.             SUBROUTINE BSPPP(T,A,N,K,LDC,C,XI,LXI,WORK)
    2.       C***BEGIN PROLOGUE  BSPPP
    3.       C***DATE WRITTEN   800901   (YYMMDD)
    4.       C***REVISION DATE  820801   (YYMMDD)
    5.       C***CATEGORY NO.  E3,K6
    6.       C***KEYWORDS  B-SPLINE,DATA FITTING,INTERPOLATION,SPLINE
    7.       C***AUTHOR  AMOS, D. E., (SNLA)
    8.       C***PURPOSE  Converts the B-representation to the piecewise
    9.       C            polynomial (PP) form for use with PPVAL.
   10.       C***DESCRIPTION
   11.       C
   12.       C     Written by Carl de Boor and modified by D. E. Amos
   13.       C
   14.       C     Reference
   15.       C         SIAM J. Numerical Analysis, 14, No. 3, June, 1977, pp.441-472.
   16.       C
   17.       C     Abstract
   18.       C         BSPPP is the BSPLPP routine of the reference.
   19.       C
   20.       C         BSPPP converts the B-representation (T,A,N,K) to the
   21.       C         piecewise polynomial (PP) form (C,XI,LXI,K) for use with
   22.       C         PPVAL.  Here XI(*), the break point array of length LXI, is
   23.       C         the knot array T(*) with multiplicities removed.  The columns
   24.       C         of the matrix C(I,J) contain the right Taylor derivatives
   25.       C         for the polynomial expansion about XI(J) for the intervals
   26.       C         XI(J) .LE. X .LE. XI(J+1), I=1,K, J=1,LXI.  Function PPVAL
   27.       C         makes this evaluation at a specified point X in
   28.       C         XI(1) .LE. X .LE. XI(LXI(1) .LE. X .LE. XI+1)
   29.       C
   30.       C         BSPPP calls BSPDR, BSPEV, INTRV, BSPVN
   31.       C
   32.       C     Description of Arguments
   33.       C         Input
   34.       C          T       - knot vector of length N+K
   35.       C          A       - B-spline coefficient vector of length N
   36.       C          N       - number of B-spline coefficients
   37.       C                    N = sum of knot multiplicities-K
   38.       C          K       - order of the B-spline, K .GE. 1
   39.       C          LDC     - leading dimension of C, LDC .GE. K
   40.       C
   41.       C         Output
   42.       C          C       - matrix of dimension at least (K,LXI) containing
   43.       C                    right derivatives at break points
   44.       C          XI      - XI break point vector of length LXI+1
   45.       C          LXI     - number of break points, LXI .LE. N-K+1
   46.       C          WORK    - work vector of length K*(N+3)
   47.       C
   48.       C     Error Conditions
   49.       C         Improper input is a fatal error
   50.       C***REFERENCES  C. DE BOOR, *PACKAGE FOR CALCULATING WITH B-SPLINES*,
   51.       C                 SIAM JOURNAL ON NUMERICAL ANALYSIS, VOLUME 14, NO. 3,
   52.       C                 JUNE 1977, PP. 441-472.
   53.       C***ROUTINES CALLED  BSPDR,BSPEV,XERROR
   54.       C***END PROLOGUE  BSPPP
   55.       C
   56.       C
   57.             INTEGER ILEFT, INEV, K, LDC, LXI, N, NK
   58.       C     DIMENSION T(N+K),XI(LXI+1),C(LDC,*)
   59.       C     HERE, * = THE FINAL VALUE OF THE OUTPUT PARAMETER LXI.
   60.             REAL*8 T(1), A(N), WORK(1), XI(1), C(LDC,1)
   61.       C***FIRST EXECUTABLE STATEMENT  BSPPP
   62.             IF(K.LT.1) GO TO 100
   63.             IF(N.LT.K) GO TO 105
   64.             IF(LDC.LT.K) GO TO 110
   65.             CALL BSPDR(T, A, N, K, K, WORK)
   66.             LXI = 0
   67.             XI(1) = T(K)
   68.             INEV = 1
   69.             NK = N*K + 1
   70.  1--<       DO 10 ILEFT=K,N
   71.  1            IF (T(ILEFT+1).EQ.T(ILEFT)) GO TO 10
   72.  1            LXI = LXI + 1
   73.  1            XI(LXI+1) = T(ILEFT+1)
   74.  1            CALL BSPEV(T,WORK(1),N,K, K,XI(LXI),INEV,C(1,LXI),WORK(NK))
   75.  1-->    10 CONTINUE
   76.             RETURN
   77.         100 CONTINUE
   78.             CALL XERROR( ' BSPPP,  K DOES NOT SATISFY K.GE.1', 34, 2, 1)
   79.             RETURN
   80.         105 CONTINUE
   81.             CALL XERROR( ' BSPPP,  N DOES NOT SATISFY N.GE.K', 34, 2, 1)
   82.             RETURN
   83.         110 CONTINUE
   84.             CALL XERROR( ' BSPPP,  LDC DOES NOT SATISFY LDC.GE.K', 38, 2, 1)
   85.             RETURN
   86.             END

