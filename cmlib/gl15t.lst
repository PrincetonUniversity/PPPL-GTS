     %%%    L o o p m a r k   L e g e n d    %%%

     Primary Loop Type        Modifiers
     ------- ---- ----        ---------
     A - Pattern matched      a - atomic memory operation
                              b - blocked
     C - Collapsed            c - conditional and/or computed
     D - Deleted               
     E - Cloned               f - fused
     G - Accelerated          g - partitioned
     I - Inlined              i - interchanged
     M - Multithreaded        m - partitioned
                              n - non-blocking remote transfer
                              p - partial
                              r - unrolled
                              s - shortloop
     V - Vectorized           w - unwound


    1.              SUBROUTINE GL15T(F,A,B,XL,XR,R,AE,RA,
    2.             1                 RASC,FMIN,FMAX)
    3.        C
    4.        C***AUTHORS          ROBERT PIESSENS AND ELISE DE DONCKER
    5.        C                    APPL. MATH. AND PROGR. DIV.- K.U.LEUVEN
    6.        C                    DAVID KAHANER, NBS WASHINGTON
    7.        C     .................................................................
    8.        C           PURPOSE
    9.        C              TO COMPUTE I = INTEGRAL OF G(X) OVER (A,B),
   10.        C                             WITH ERROR ESTIMATE
   11.        C                         J = INTEGRAL OF ABS(G) OVER (A,B)
   12.        C
   13.        C           PARAMETERS
   14.        C            ON ENTRY
   15.        C              F      - REAL
   16.        C                       FUNCTION SUBPROGRAM DEFINING THE INTEGRAND
   17.        C                       FUNCTION F(X). THE ACTUAL NAME FOR F NEEDS
   18.        C                       TO BE DECLARED E X T E R N A L IN THE
   19.        C                       CALLING PROGRAM.
   20.        C                       THE FUNCTION G(X) IS DEFINED TO BE
   21.        C                       G(X)=F(PHI(X))*PHIP(X)
   22.        C                       WHERE PHI(X) IS THE CUBIC GIVEN BY
   23.        C                       THE ARITHMETIC STATEMENT FUNCTION BELOW.
   24.        C                       PHIP(X) IS ITS DERIVATIVE.  THE VARIABLES
   25.        C                       XL AND XR ARE THE LEFT AND RIGHT ENDPOINTS
   26.        C                       OF A PARENT INTERVAL OF WHICH (A,B) IS A PART.
   27.        C
   28.        C              A      - REAL
   29.        C                       LOWER LIMIT OF INTEGRATION
   30.        C
   31.        C              B      - REAL
   32.        C                       UPPER LIMIT OF INTEGRATION
   33.        C
   34.        C              XL     - DOUBLE PRECISION
   35.        C              XR     - DOUBLE PRECISION
   36.        C                       LOWER AND UPPER LIMITS OF PARENT INTERVAL
   37.        C                       OF WHICH [A,B] IS A PART.
   38.        C
   39.        C            ON RETURN
   40.        C              R - REAL
   41.        C                       APPROXIMATION TO THE INTEGRAL I
   42.        C                       R IS COMPUTED BY APPLYING THE 15-POINT
   43.        C                       KRONROD RULE (RESK) OBTAINED BY OPTIMAL
   44.        C                       ADDITION OF ABSCISSAE TO THE 7-POINT GAUSS
   45.        C                       RULE (RESG).
   46.        C
   47.        C              AE - REAL
   48.        C                       ESTIMATE OF THE MODULUS OF THE ABSOLUTE ERROR,
   49.        C                       WHICH SHOULD NOT EXCEED ABS(I-R)
   50.        C
   51.        C              RA - REAL
   52.        C                       APPROXIMATION TO THE INTEGRAL J
   53.        C
   54.        C              RASC - REAL
   55.        C                       APPROXIMATION TO THE INTEGRAL OF ABS(G-I/(B-A))
   56.        C                       OVER (A,B)
   57.        C
   58.        C              FMAX, FMIN - REAL
   59.        C                       MAX AND MIN VALUES OF THE FUNCTION F ON (A,B)
   60.        C           SUBROUTINES OR FUNCTIONS NEEDED
   61.        C                 - F (USER-PROVIDED FUNCTION)
   62.        C                 - R1MACH
   63.        C                 - FORTRAN ABS, AMAX1, AMIN1
   64.        C
   65.        C     .................................................................
   66.        C***END PROLOGUE
   67.        C
   68.              implicit none
   69.              SAVE EPMACH,UFLOW
   70.              REAL*8 FMIN,FMAX,PHI,PHIP,SL,SR,PHIU
   71.              REAL*8 A,AE,B,DHLGTH,EPMACH,F,FC,FSUM,FVAL1,FVAL2,
   72.             *  HLGTH,RA,RASC,RESG,RESK,RESKH,R,R1MACH,UFLOW
   73.              REAL*8 XL,XR,CENTR,ABSC,U
   74.              REAL*8 X,DX
   75.              INTEGER J,JTW,JTWM1,I
   76.        C
   77.              REAL*8 FV1(7),FV2(7),WG(4),WGK(8),XGK(8)
   78.        C
   79.        C           THE ABSCISSAE AND WEIGHTS ARE GIVEN FOR THE INTERVAL (-1,1)
   80.        C           BECAUSE OF SYMMETRY ONLY THE POSITIVE ABSCISSAE AND THEIR
   81.        C           CORRESPONDING WEIGHTS ARE GIVEN.
   82.        C
   83.        C           XGK    - ABSCISSAE OF THE 15-POINT KRONROD RULE
   84.        C                    XGK(2), XGK(4), ...  ABSCISSAE OF THE 7-POINT
   85.        C                    GAUSS RULE
   86.        C                    XGK(1), XGK(3), ...  ABSCISSAE WHICH ARE OPTIMALLY
   87.        C                    ADDED TO THE 7-POINT GAUSS RULE
   88.        C
   89.        C           WGK    - WEIGHTS OF THE 15-POINT KRONROD RULE
   90.        C
   91.        C           WG     - WEIGHTS OF THE 7-POINT GAUSS RULE
   92.        C
   93.              DATA XGK(1),XGK(2),XGK(3),XGK(4),XGK(5),XGK(6),XGK(7),XGK(8)/
   94.             *     0.9914553711208126E+00,   0.9491079123427585E+00,
   95.             *     0.8648644233597691E+00,   0.7415311855993944E+00,
   96.             *     0.5860872354676911E+00,   0.4058451513773972E+00,
   97.             *     0.2077849550078985E+00,   0.0E+00              /
   98.              DATA WGK(1),WGK(2),WGK(3),WGK(4),WGK(5),WGK(6),WGK(7),WGK(8)/
   99.             *     0.2293532201052922E-01,   0.6309209262997855E-01,
  100.             *     0.1047900103222502E+00,   0.1406532597155259E+00,
  101.             *     0.1690047266392679E+00,   0.1903505780647854E+00,
  102.             *     0.2044329400752989E+00,   0.2094821410847278E+00/
  103.              DATA WG(1),WG(2),WG(3),WG(4)/
  104.             *     0.1294849661688697E+00,   0.2797053914892767E+00,
  105.             *     0.3818300505051189E+00,   0.4179591836734694E+00/
  106.        C
  107.              PHI(U)=XR-(XR-XL)*U*U*(2.D0*U+3.D0)
  108.              PHIP(U)=-6.D0*U*(U+1.D0)
  109.        C
  110.        C           LIST OF MAJOR VARIABLES
  111.        C           -----------------------
  112.        C
  113.        C           CENTR  - MID POINT OF THE INTERVAL
  114.        C           HLGTH  - HALF-LENGTH OF THE INTERVAL
  115.        C           ABSC   - ABSCISSA
  116.        C           FVAL*  - FUNCTION VALUE
  117.        C           RESG   - R OF THE 7-POINT GAUSS FORMULA
  118.        C           RESK   - R OF THE 15-POINT KRONROD FORMULA
  119.        C           RESKH  - APPROXIMATION TO THE MEAN VALUE OF F OVER (A,B),
  120.        C                    I.E. TO I/(B-A)
  121.        C
  122.        C           MACHINE DEPENDENT CONSTANTS
  123.        C           ---------------------------
  124.        C
  125.        C           EPMACH IS THE LARGEST RELATIVE SPACING.
  126.        C           UFLOW IS THE SMALLEST POSITIVE MAGNITUDE.
  127.        C
  128.        C***FIRST EXECUTABLE STATEMENT
  129.              DATA EPMACH,UFLOW/0.0D0,0.0D0/
  130.              IF(EPMACH.EQ.0.0D0) THEN
  131.                 EPMACH=EPSILON(0.D0)
  132.                 UFLOW=TINY(0.D0)
  133.              ENDIF
  134.        C
  135.              IF(XL.LT.XR)THEN
  136.                 SL=XL
  137.                 SR=XR
  138.                ELSE
  139.                 SL=XR
  140.                 SR=XL
  141.              ENDIF
  142.              HLGTH = 0.5D+00*(B-A)
  143.              CENTR = A+HLGTH
  144.              DHLGTH = ABS(HLGTH)
  145.        C
  146.        C           COMPUTE THE 15-POINT KRONROD APPROXIMATION TO
  147.        C           THE INTEGRAL, AND ESTIMATE THE ABSOLUTE ERROR.
  148.        C
  149.              U=(CENTR-XR)/(XR-XL)
  150.              PHIU=PHI(U)
  151.              IF(PHIU.LE.SL .OR. PHIU.GE.SR) PHIU=CENTR
  152.              FMIN=F(PHIU)
  153.              FMAX=FMIN
  154.              FC=FMIN*PHIP(U)
  155.              RESG = FC*WG(4)
  156.              RESK = FC*WGK(8)
  157.              RA = ABS(RESK)
  158.  1---<       DO 10 J=1,3
  159.  1             JTW = J*2
  160.  1             ABSC = HLGTH*XGK(JTW)
  161.  1             U=(CENTR-ABSC-XR)/(XR-XL)
  162.  1             PHIU=PHI(U)
  163.  1             IF(PHIU.LE.SL .OR. PHIU.GE.SR) PHIU=CENTR
  164.  1             FVAL1=F(PHIU)
  165.  1             FMAX=MAX(FMAX,FVAL1)
  166.  1             FMIN=MIN(FMIN,FVAL1)
  167.  1             FVAL1=FVAL1*PHIP(U)
  168.  1             U=(CENTR+ABSC-XR)/(XR-XL)
  169.  1             PHIU=PHI(U)
  170.  1             IF(PHIU.LE.SL .OR. PHIU.GE.SR) PHIU=CENTR
  171.  1             FVAL2=F(PHIU)
  172.  1             FMAX=MAX(FMAX,FVAL2)
  173.  1             FMIN=MIN(FMIN,FVAL2)
  174.  1             FVAL2=FVAL2*PHIP(U)
  175.  1             FV1(JTW) = FVAL1
  176.  1             FV2(JTW) = FVAL2
  177.  1             FSUM = FVAL1+FVAL2
  178.  1             RESG = RESG+WG(J)*FSUM
  179.  1             RESK = RESK+WGK(JTW)*FSUM
  180.  1             RA = RA+WGK(JTW)*(ABS(FVAL1)+ABS(FVAL2))
  181.  1--->    10 CONTINUE
  182.  1---<       DO 15 J = 1,4
  183.  1             JTWM1 = J*2-1
  184.  1             ABSC = HLGTH*XGK(JTWM1)
  185.  1             U=(CENTR-ABSC-XR)/(XR-XL)
  186.  1             PHIU=PHI(U)
  187.  1             IF(PHIU.LE.SL .OR. PHIU.GE.SR) PHIU=CENTR
  188.  1             FVAL1=F(PHIU)
  189.  1             FMAX=MAX(FMAX,FVAL1)
  190.  1             FMIN=MIN(FMIN,FVAL1)
  191.  1             FVAL1=FVAL1*PHIP(U)
  192.  1             U=(CENTR+ABSC-XR)/(XR-XL)
  193.  1             PHIU=PHI(U)
  194.  1             IF(PHIU.LE.SL .OR. PHIU.GE.SR) PHIU=CENTR
  195.  1             FVAL2=F(PHIU)
  196.  1             FMAX=MAX(FMAX,FVAL2)
  197.  1             FMIN=MIN(FMIN,FVAL2)
  198.  1             FVAL2=FVAL2*PHIP(U)
  199.  1             FV1(JTWM1) = FVAL1
  200.  1             FV2(JTWM1) = FVAL2
  201.  1             FSUM = FVAL1+FVAL2
  202.  1             RESK = RESK+WGK(JTWM1)*FSUM
  203.  1             RA = RA+WGK(JTWM1)*(ABS(FVAL1)+ABS(FVAL2))
  204.  1--->    15 CONTINUE
  205.              RESKH = RESK*0.5D+00
  206.              RASC = WGK(8)*ABS(FC-RESKH)
  207.  Vw--<       DO 20 J=1,7
  208.  Vw            RASC = RASC+WGK(J)*(ABS(FV1(J)-RESKH)+ABS(FV2(J)-RESKH))
  209.  Vw-->    20 CONTINUE
  210.              R = RESK*HLGTH
  211.              RA = RA*DHLGTH
  212.              RASC = RASC*DHLGTH
  213.              AE = ABS((RESK-RESG)*HLGTH)
  214.              IF(RASC.NE.0.0D+00.AND.AE.NE.0.0D+00)
  215.             &  AE = RASC*MIN(0.1D+01,(0.2D+03*AE/RASC)**1.5D+00)
  216.              IF(RA.GT.UFLOW/(0.5D+02*EPMACH))AE=MAX((EPMACH*0.5D+02)*RA,AE)
  217.              RETURN
  218.              END

