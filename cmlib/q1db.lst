     %%%    L o o p m a r k   L e g e n d    %%%

     Primary Loop Type        Modifiers
     ------- ---- ----        ---------
     There are no optimizations or loops to mark


    1.          SUBROUTINE Q1DB(F,A,B,EPS,R,E,KF,IFLAG)
    2.    C***BEGIN PROLOGUE Q1DB
    3.    C***DATE WRITTEN 830913
    4.    C***REVISION DATE 821018
    5.    C***CATEGORY NO.  D1B1A1
    6.    C***KEYWORDS   ADAPTIVE  QUADRATUE, AUTOMATIC  QUADRATURE
    7.    C***AUTHOR  KAHANER, DAVID K., SCIENTIFIC COMPUTING DIVISION, NBS.
    8.    C***PURPOSE  APPROXIMATES ONE DIMENSIONAL INTEGRALS OF USER DEFINED
    9.    C            FUNCTIONS, EASY TO USE, ALLOWS GENERAL INTEGRAND NAME.
   10.    C
   11.    C***DESCRIPTION
   12.    C       Q1DB IS A SUBROUTINE FOR THE AUTOMATIC EVALUATION
   13.    C            OF THE DEFINITE INTEGRAL OF A USER DEFINED FUNCTION
   14.    C            OF ONE VARIABLE.
   15.    C
   16.    C       A R G U M E N T S   I N   T H E   C A L L   S E Q U E N C E
   17.    C
   18.    C       F     (INPUT) THE NAME OF YOUR INTEGRAND FUNCTION.  THIS
   19.    C                MUST BE THE NAME OF A FORTRAN FUNCTION WHICH
   20.    C                EVALUATES THE INTEGRAND, AND WILL BE OF THE FORM
   21.    C                   FUNCTION F(X)
   22.    C                      F=(EVALUATE THE INTEGRAND AT THE POINT X)
   23.    C                      RETURN
   24.    C                   END
   25.    C                THE NAME WHICH YOU CHOOSE MUST APPEAR IN EXACTLY
   26.    C                THREE PLACES...
   27.    C                  (1) AN  "EXTERNAL F" STATEMENT IN THE CODE
   28.    C                       WHICH CALLS Q1DB
   29.    C                  (2) AS THE FIRST ARGUMENT IN THE CALL TO Q1DB
   30.    C                  (3) IN THE "FUNCTION F(X)" WHICH COMPUTES F(X)
   31.    C                SEE EXAMPLE BELOW.
   32.    C       A
   33.    C       B     (INPUT) THE ENDPOINTS OF THE INTEGRATION INTERVAL
   34.    C       EPS   (INPUT) THE ACCURACY TO WHICH YOU WANT THE INTEGRAL
   35.    C                COMPUTED.  IF YOU WANT 2 DIGITS OF ACCURACY SET
   36.    C                EPS=.01, FOR 3 DIGITS SET EPS=.001, ETC.
   37.    C                EPS MUST BE POSITIVE.
   38.    C       R     (OUTPUT) Q1DB'S BEST ESTIMATE OF YOUR INTEGRAL
   39.    C       E     (OUTPUT) AN ESTIMATE OF ABS(INTEGRAL-R)
   40.    C       KF    (OUTPUT) THE COST OF THE INTEGRATION, MEASURED IN
   41.    C                   NUMBER OF EVALUATIONS OF YOUR INTEGRAND.
   42.    C                   KF WILL ALWAYS BE AT LEAST 30.
   43.    C       IFLAG (OUTPUT) TERMINATION FLAG...POSSIBLE VALUES ARE
   44.    C               0   NORMAL COMPLETION, E SATISFIES
   45.    C                        E<EPS  AND  E<EPS*ABS(R)
   46.    C               1   NORMAL COMPLETION, E SATISFIES
   47.    C                        E<EPS, BUT E>EPS*ABS(R)
   48.    C               2   NORMAL COMPLETION, E SATISFIES
   49.    C                        E<EPS*ABS(R), BUT E>EPS
   50.    C               3   NORMAL COMPLETION BUT EPS WAS TOO SMALL TO
   51.    C                     SATISFY ABSOLUTE OR RELATIVE ERROR REQUEST.
   52.    C
   53.    C               4   ABORTED CALCULATION BECAUSE OF SERIOUS ROUNDING
   54.    C                     ERROR.  PROBABLY E AND R ARE CONSISTENT.
   55.    C               5   ABORTED CALCULATION BECAUSE OF INSUFFICIENT STORAGE.
   56.    C                     R AND E ARE CONSISTENT.
   57.    C               6   ABORTED CALCULATION BECAUSE OF SERIOUS DIFFICULTIES
   58.    C                     MEETING YOUR ERROR REQUEST.
   59.    C               7   ABORTED CALCULATION BECAUSE EPS WAS SET <= 0.0
   60.    C
   61.    C            NOTE...IF IFLAG=3, 4, 5 OR 6 CONSIDER USING Q1DAX INSTEAD.
   62.    C
   63.    C    T Y P I C A L   P R O B L E M   S E T U P
   64.    C
   65.    C          EXTERNAL FUNC     (CAN USE ANY NAME FOR INTEGRAND)
   66.    C          A=0.0
   67.    C          B=1.0          (SET INTERVAL ENDPOINTS TO [0,1])
   68.    C          EPS=0.001       (SET ACCURACY REQUEST FOR 3 DIGITS)
   69.    C          CALL Q1DB(FUNC,A,B,EPS,R,E,KF,IFLAG)
   70.    C          END
   71.    C          FUNCTION FUNC(X)
   72.    C            FUNC=SIN(2.*X)-SQRT(X)     (FOR EXAMPLE)
   73.    C            RETURN
   74.    C          END
   75.    C      FOR THIS SAMPLE PROBLEM, THE OUTPUT IS
   76.    C  0.0    1.0     .001    .041406750    .69077E-07    30    0
   77.    C
   78.    C    R E M A R K   I.
   79.    C
   80.    C           A SMALL AMOUT OF RANDOMIZATION IS BUILT INTO THIS PROGRAM.
   81.    C           CALLING Q1DB A FEW TIMES IN SUCCESSION WILL GIVE DIFFERENT
   82.    C           BUT HOPEFULLY CONSISTENT RESULTS.
   83.    C
   84.    C   R E M A R K   II.
   85.    C
   86.    C           THIS ROUTINE IS DESIGNED FOR INTEGRATION OVER A FINITE
   87.    C           INTERVAL.  THUS THE INPUT ARGUMENTS A AND B MUST BE
   88.    C           VALID REAL NUMBERS ON YOUR COMPUTER.  IF YOU WANT TO DO
   89.    C           AN INTEGRAL OVER AN INFINITE INTERVAL SET A OR B OR BOTH
   90.    C           LARGE ENOUGH SO THAT THE INTERVAL [A,B] CONTAINS MOST OF
   91.    C           THE INTEGRAND.  CARE IS NECESSARY, HOWEVER.  FOR EXAMPLE,
   92.    C           TO INTEGRATE EXP(-X*X) ON THE ENTIRE REAL LINE ONE COULD
   93.    C           TAKE A=-20., B=20. OR SIMILAR VALUES TO GET GOOD RESULTS.
   94.    C           IF YOU TOOK A=-1.E10 AND B=+1.E10 TWO BAD THINGS WOULD
   95.    C           OCCUR. FIRST, YOU WILL CERTAINLY GET AN ERROR MESSAGE FROM
   96.    C           THE EXP ROUTINE, AS ITS ARGUMENT IS TOO SMALL.  OTHER
   97.    C           THINGS COULD HAPPEN TOO, FOR EXAMPLE AN UNDERFLOW.
   98.    C           SECOND, EVEN IF THE ARITHMETIC WORKED PROPERLY Q1DA WILL
   99.    C           SURELY GIVE AN INCORRECT ANSWER, BECAUSE ITS FIRST TRY
  100.    C           AT SAMPLING THE INTEGRAND IS BASED ON YOUR SCALING AND
  101.    C           IT IS VERY UNLIKELY TO SELECT EVALUATION POINTS IN THE
  102.    C           INFINITESMALLY SMALL INTERVAL [-20,20] WHERE ALL THE
  103.    C           INTEGRAND IS CONCENTRATED, WHEN A, B ARE SO LARGE.
  104.    C
  105.    C    M O R E   F L E X I B I L I T Y
  106.    C
  107.    C           Q1DB IS AN EASY TO USE DRIVER FOR ANOTHER PROGRAM, Q1DAX.
  108.    C           Q1DAX PROVIDES SEVERAL OPTIONS WHICH ARE NOT AVAILABLE
  109.    C                WITH Q1DB.  AN EVEN EASIER TO USE PROGRAM IS Q1DA.
  110.    C
  111.    C***REFERENCES  (NONE)
  112.    C***ROUTINES CALLED (Q1DAX)
  113.    C    E N D   O F   D O C U M E N T A T I O N
  114.    C***END PROLOGUE Q1DB
  115.    C
  116.          DIMENSION W(50,6)
  117.          LOGICAL RST
  118.          EXTERNAL F
  119.    C
  120.    C***FIRST EXECUTUTABLE STATEMENT Q1DB
  121.          NINT=1
  122.          RST = .FALSE.
  123.          NMAX=50
  124.          CALL Q1DAX(F,A,B,EPS,R,E,NINT,RST,W,NMAX,FMIN,FMAX,KF,IFLAG)
  125.          RETURN
  126.          END

