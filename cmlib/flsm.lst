     %%%    L o o p m a r k   L e g e n d    %%%

     Primary Loop Type        Modifiers
     ------- ---- ----        ---------
     A - Pattern matched      a - atomic memory operation
                              b - blocked
     C - Collapsed            c - conditional and/or computed
     D - Deleted               
     E - Cloned               f - fused
     G - Accelerated          g - partitioned
     I - Inlined              i - interchanged
     M - Multithreaded        m - partitioned
                              n - non-blocking remote transfer
                              p - partial
                              r - unrolled
                              s - shortloop
     V - Vectorized           w - unwound


    1.                REAL*8 FUNCTION FLSM(S,CENTER,HWIDTH,X,M,MP,MAXORD,G,F,SUMCLS)
    2.          C
    3.          C***  FUNCTION TO COMPUTE FULLY SYMMETRIC BASIC RULE SUM
    4.          C
    5.                EXTERNAL F
    6.                INTEGER S, M(S), MP(S), MAXORD, SUMCLS, IXCHNG, LXCHNG, I, L,
    7.               * IHALF, MPI, MPL
    8.                REAL*8 G(MAXORD), X(S), INTWGT, ZERO, ONE, TWO, INTSUM,
    9.               * CENTER(S), HWIDTH(S), F
   10.                ZERO = 0
   11.                ONE = 1
   12.                TWO = 2
   13.                INTWGT = ONE
   14.  Vr2---<       DO 10 I=1,S
   15.  Vr2             MP(I) = M(I)
   16.  Vr2             IF (M(I).NE.0) INTWGT = INTWGT/TWO
   17.  Vr2             INTWGT = INTWGT*HWIDTH(I)
   18.  Vr2--->    10 CONTINUE
   19.                SUMCLS = 0
   20.                FLSM = ZERO
   21.          C
   22.          C*******  COMPUTE CENTRALLY SYMMETRIC SUM FOR PERMUTATION MP
   23.             20 INTSUM = ZERO
   24.  Vpr2--<       DO 30 I=1,S
   25.  Vpr2            MPI = MP(I) + 1
   26.  Vpr2            X(I) = CENTER(I) + G(MPI)*HWIDTH(I)
   27.  Vpr2-->    30 CONTINUE
   28.             40 SUMCLS = SUMCLS + 1
   29.                INTSUM = INTSUM + F(S,X)
   30.  1-----<       DO 50 I=1,S
   31.  1               MPI = MP(I) + 1
   32.  1               IF(G(MPI).NE.ZERO) HWIDTH(I) = -HWIDTH(I)
   33.  1               X(I) = CENTER(I) + G(MPI)*HWIDTH(I)
   34.  1               IF (X(I).LT.CENTER(I)) GO TO 40
   35.  1----->    50 CONTINUE
   36.          C*******  END INTEGRATION LOOP FOR MP
   37.          C
   38.                FLSM = FLSM + INTWGT*INTSUM
   39.                IF (S.EQ.1) RETURN
   40.          C
   41.          C*******  FIND NEXT DISTINCT PERMUTATION OF M AND LOOP BACK
   42.          C          TO COMPUTE NEXT CENTRALLY SYMMETRIC SUM
   43.  1-----<       DO 80 I=2,S
   44.  1               IF (MP(I-1).LE.MP(I)) GO TO 80
   45.  1               MPI = MP(I)
   46.  1               IXCHNG = I - 1
   47.  1               IF (I.EQ.2) GO TO 70
   48.  1               IHALF = IXCHNG/2
   49.  1 2---<         DO 60 L=1,IHALF
   50.  1 2               MPL = MP(L)
   51.  1 2               IMNUSL = I - L
   52.  1 2               MP(L) = MP(IMNUSL)
   53.  1 2               MP(IMNUSL) = MPL
   54.  1 2               IF (MPL.LE.MPI) IXCHNG = IXCHNG - 1
   55.  1 2               IF (MP(L).GT.MPI) LXCHNG = L
   56.  1 2--->    60   CONTINUE
   57.  1               IF (MP(IXCHNG).LE.MPI) IXCHNG = LXCHNG
   58.  1          70   MP(I) = MP(IXCHNG)
   59.  1               MP(IXCHNG) = MPI
   60.  1               GO TO 20
   61.  1----->    80 CONTINUE
   62.          C*****  END LOOP FOR PERMUTATIONS OF M AND ASSOCIATED SUMS
   63.          C
   64.                RETURN
   65.                END

