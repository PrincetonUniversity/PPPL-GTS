     %%%    L o o p m a r k   L e g e n d    %%%

     Primary Loop Type        Modifiers
     ------- ---- ----        ---------
     A - Pattern matched      a - atomic memory operation
                              b - blocked
     C - Collapsed            c - conditional and/or computed
     D - Deleted               
     E - Cloned               f - fused
     G - Accelerated          g - partitioned
     I - Inlined              i - interchanged
     M - Multithreaded        m - partitioned
                              n - non-blocking remote transfer
                              p - partial
                              r - unrolled
                              s - shortloop
     V - Vectorized           w - unwound


    1.               SUBROUTINE Q1DAX(F,A,B,EPS,R,E,N_INT,RST,W,NMAX,FMIN,FMAX,
    2.              &                 KF,IFLAG)
    3.               implicit none
    4.         C***BEGIN PROLOGUE Q1DAX
    5.         C***DATE WRITTEN 821118
    6.         C***REVISION DATE 821118
    7.         C***CATEGORY NO. D1B1A1
    8.         C***KEYWORDS  ADAPTIVE QUADRATURE, AUTOMATIC QUADRATURE
    9.         C***AUTHOR  KAHANER, DAVID K., SCIENTIFIC COMPUING DIVISION, NBS.
   10.         C***PURPOSE  APPROXIMATES ONE DIMENSIONAL INTEGRALS OF USER DEFINED
   11.         C            FUNCTIONS, FLEXIBLE USAGE.
   12.         C
   13.         C***DESCRIPTION
   14.         C
   15.         C       Q1DAX IS A FLEXIBLE SUBROUTINE FOR THE AUTOMATIC EVALUATION
   16.         C             OF DEFINITE INTEGRALS OF A USER DEFINED FUNCTION
   17.         C             OF ONE VARIABLE.
   18.         C
   19.         C             FOR EASIER TO USE ROUTINES SEE Q1DA OR Q1DB.
   20.         C
   21.         C             CAPABILITIES OF Q1DAX (IN ADDITION TO THOSE OF Q1DA, Q1DB)
   22.         C             INCLUDE:
   23.         C                ABILITY TO RESTART A CALCULATION TO GREATER
   24.         C                  ACCURACY WITHOUT PENALTY...
   25.         C                ABILITY TO SPECIFY AN INITIAL PARTITION OF
   26.         C                  THE INTEGRATION INTERVAL...
   27.         C                ABILITY TO INCREASE THE WORK SPACE TO HANDLE
   28.         C                  MORE DIFFICULT PROBLEMS...
   29.         C                OUTPUT OF LARGEST/SMALLEST INTEGRAND VALUE FOR
   30.         C                  APPLICATIONS SUCH AS SCALING GRAPHS...
   31.         C
   32.         C       A R G U M E N T S   I N   T H E   C A L L   S E Q U E N C E
   33.         C
   34.         C       F      (INPUT) THE NAME OF YOUR INTEGRAND FUNCTION.
   35.         C                      THIS NAME MUST APPEAR IN AN EXTERNAL STATEMENT
   36.         C                      IN ANY PROGRAM WHICH CALLS Q1DAX.
   37.         C                      YOU MUST WRITE F IN THE FORM
   38.         C                           FUNCTION F(X)
   39.         C                              F=(EVALUATE INTEGRAND AT THE POINT X)
   40.         C                              RETURN
   41.         C                           END
   42.         C       A
   43.         C       B       (INPUT) ENDPOINTS OF INTEGRATION INTERVAL
   44.         C       EPS     (INPUT)  ACCURACY TO WHICH THE INTEGRAL IS TO BE CALCULA
   45.         C                          Q1DAX WILL TRY TO ACHIEVE RELATIVE ACCURACY,
   46.         C                          E.G. SET EPS=.01 FOR 2 DIGITS, .001 FOR 3, ET
   47.         C       R       (OUTPUT) THE ESTIMATE OF THE INTEGRAL
   48.         C       E       (OUTPUT) THE ESTIMATE OF THE ABSOLUTE ERROR IN R.
   49.         C       N_INT    (INPUT
   50.         C                OUTPUT)
   51.         C                        AS AN INPUT QUANTITY, N_INT MUST BE SET TO
   52.         C                          THE NUMBER OF SUBINTERVALS IN THE INITIAL
   53.         C                          PARTITION OF [A,B].  FOR MOST PROBLEMS
   54.         C                          THIS IS JUST 1, THE INTERVAL [A,B] ITSELF.
   55.         C                          N_INT MUST BE LESS THAN NMAX, SEE BELOW.
   56.         C                          N_INT IS USEFUL IF YOU WOULD LIKE TO HELP
   57.         C                          Q1DAX LOCATE A DIFFICULT SPOT ON [A,B].
   58.         C                          IN THIS REGARD N_INT IS USED ALONG
   59.         C                          WITH THE ARRAY W (SEE BELOW).  IF YOU SET
   60.         C                          N_INT=1 IT IS NOT NECESSARY TO BE CONCERNED
   61.         C                          WITH W, EXCEPT THAT IT MUST BE DIMENSIONED...
   62.         C                          AS AN EXAMPLE OF MORE GENERAL APPLICATIONS,
   63.         C                          IF [A,B]=[0,1] BUT THE INTEGRAND JUMPS AT 0.3
   64.         C                          IT WOULD BE WISE TO SET N_INT=2 AND THEN SET
   65.         C                                  W(1,1)=0.0  (LEFT ENDPOINT)
   66.         C                                  W(2,1)=0.3  (SINGULAR POINT)
   67.         C                                  W(3,1)=1.0  (RIGHT ENDPOINT)
   68.         C                          IF YOU SET N_INT GREATER THAN 1, BE SURE TO
   69.         C                          CHECK THAT YOU HAVE ALSO SET
   70.         C                                W(1,1)=A  AND  W(N_INT+1,1)=B
   71.         C                        AS AN OUTPUT QUANTITY, N_INT GIVES THE
   72.         C                          NUMBER OF SUBINTERVALS IN THE FINAL
   73.         C                          PARTITION OF [A,B].
   74.         C       RST     (INPUT) A LOGICAL VARIABLE (E.G. TRUE OR FALSE)
   75.         C                       SET RST=.FALSE. FOR INITIAL CALL TO Q1DAX
   76.         C                       SET RST=.TRUE. FOR A SUBSEQUENT CALL,
   77.         C                           E.G. ONE FOR WHICH MORE ACCURACY IS
   78.         C                           DESIRED (SMALLER EPS).  A RESTART ONLY
   79.         C                           MAKES SENSE IF THE PRECEDING CALL RETURNED
   80.         C                           WITH A VALUE OF IFLAG (SEE BELOW) LESS THAN 
   81.         C                           ON A RESTART YOU MAY NOT CHANGE THE VALUES O
   82.         C                           OTHER ARGUMENTS IN THE CALL SEQUENCE, EXCEPT
   83.         C       W(NMAX,6) (INPUT &
   84.         C                  SCRATCH)
   85.         C                       W IS AN ARRAY USED BY Q1DAX.
   86.         C                        YOU  M U S T  INCLUDE A DIMENSION STATEMENT IN
   87.         C                        YOUR CALLING PROGRAM TO ALLOCATE THIS STORAGE.
   88.         C                        THIS SHOULD BE OF THE FORM
   89.         C                                   DIMENSION W(NMAX,6)
   90.         C                        WHERE NMAX IS AN INTEGER. AN ADEQUATE VALUE OF
   91.         C                        NMAX IS 50.  IF YOU SET N_INT>1 YOU MUST ALSO
   92.         C                        INITIALIZE W, SEE N_INT ABOVE.
   93.         C       NMAX    (INPUT) AN INTEGER EQUAL TO THE FIRST SUBSCRIPT IN THE
   94.         C                        DIMENSION STATEMENT FOR THE ARRAY W.  THIS IS
   95.         C                        ALSO EQUAL TO THE MAXIMUM NUMBER OF SUBINTERVAL
   96.         C                        PERMITTED IN THE INTERNAL PARTITION OF [A,B].
   97.         C                        A VALUE OF 50 IS AMPLE FOR MOST PROBLEMS.
   98.         C       FMIN
   99.         C       FMAX    (OUTPUT) THE SMALLEST AND LARGEST VALUES OF THE INTEGRAN
  100.         C                          WHICH OCCURRED DURING THE CALCULATION.  THE
  101.         C                          ACTUAL INTEGRAND RANGE ON [A,B] MAY, OF COURS
  102.         C                          BE GREATER BUT PROBABLY NOT BY MORE THAN 10%.
  103.         C       KF      (OUTPUT) THE ACTUAL NUMBER OF INTEGRAND EVALUATIONS USED
  104.         C                          BY Q1DAX TO APPROXIMATE THIS INTEGRAL.  KF
  105.         C                          WILL ALWAYS BE AT LEAST 30.
  106.         C       IFLAG   (OUTPUT) TERMINATION FLAG...POSSIBLE VALUES ARE
  107.         C                  0   NORMAL COMPLETION, E SATISFIES
  108.         C                           E<EPS  AND  E<EPS*ABS(R)
  109.         C                  1   NORMAL COMPLETION, E SATISFIES
  110.         C                           E<EPS, BUT E>EPS*ABS(R)
  111.         C                  2   NORMAL COMPLETION, E SATISFIES
  112.         C                           E<EPS*ABS(R), BUT E>EPS
  113.         C                  3   NORMAL COMPLETION BUT EPS WAS TOO SMALL TO
  114.         C                        SATISFY ABSOLUTE OR RELATIVE ERROR REQUEST.
  115.         C                  4   ABORTED CALCULATION BECAUSE OF SERIOUS ROUNDING
  116.         C                        ERROR.  PROBABLY E AND R ARE CONSISTENT.
  117.         C                  5   ABORTED CALCULATION BECAUSE OF INSUFFICIENT STORA
  118.         C                        R AND E ARE CONSISTENT.  PERHAPS INCREASING NMA
  119.         C                        WILL PRODUCE BETTER RESULTS.
  120.         C                  6   ABORTED CALCULATION BECAUSE OF SERIOUS DIFFICULTI
  121.         C                        MEETING YOUR ERROR REQUEST.
  122.         C                  7   ABORTED CALCULATION BECAUSE EITHER EPS, N_INT OR N
  123.         C                        HAS BEEN SET TO AN ILLEGAL VALUE.
  124.         C                  8   ABORTED CALCULATION BECAUSE YOU SET N_INT>1 BUT FO
  125.         C                        TO SET W(1,1)=A  AND  W(N_INT+1,1)=B
  126.         C
  127.         C     T Y P I C A L   P R O B L E M   S E T   U P
  128.         C
  129.         C      DIMENSION W(50,6)
  130.         C      LOGICAL RST
  131.         C      EXTERNAL F
  132.         C      A=0.0
  133.         C      B=1.0
  134.         C      W(1,1)=A
  135.         C      W(2,1)=.3      [SET INTERNAL PARTITION POINT AT .3]
  136.         C      W(3,1)=B
  137.         C      N_INT=2         [INITIAL PARTITION HAS 2 INTERVALS]
  138.         C      RST=.FALSE.
  139.         C      EPS=.001
  140.         C      NMAX=50
  141.         C
  142.         C    1 CALL Q1DAX(F,A,B,EPS,R,E,N_INT,RST,W,NMAX,FMIN,FMAX,KF,IFLAG)
  143.         C
  144.         C      IF(EPS.EQ. .0001 .OR. IFLAG.GE.3)STOP
  145.         C      RST=.TRUE
  146.         C      EPS=.0001      [ASK FOR ANOTHER DIGIT]
  147.         C      GO TO 1
  148.         C      END
  149.         C      FUNCTION F(X)
  150.         C      IF(X.LT. .3)
  151.         C     1  THEN
  152.         C          F=X**(0.2)*ALOG(X)
  153.         C        ELSE
  154.         C          F=SIN(X)
  155.         C      ENDIF
  156.         C      RETURN
  157.         C      END
  158.         C
  159.         C
  160.         C            R E M A R K
  161.         C
  162.         C               WHEN YOU USE Q1ADX WITH N_INT=1, WE HAVE BUILT A SMALL
  163.         C            AMOUNT OF RANDOMIZATION INTO IT.  REPEATED CALLS DURING
  164.         C            THE SAME RUN WILL PRODUCE DIFFERENT, BUT HOPEFULLY
  165.         C            CONSISTENT, RESULTS.
  166.         C
  167.         C    E N D   O F   D O C U M E N T A T I O N
  168.         C***REFERENCES  (NONE)
  169.         C***ROUTINES CALLED (R1MACH,UNI,GL15T)
  170.         C S.Ethier 4/5/07  R1MACH() function can be replaced by Fortran 90 inquiry
  171.         C                  functions: tiny(),huge(),precision(),etc.
  172.         C  R1MACH(1) = tiny()
  173.         C  R1MACH(2) = huge()
  174.         C  R1MACH(3) = 
  175.         C  R1MACH(4) = epsilon()
  176.         C  R1MACH(5) = log10(2)
  177.         C
  178.         C***END PROLOGUE Q1DAX
  179.         C
  180.               integer n_int,nmax,kf,iflag
  181.               real(8) a,b,eps,r,e,fmin,fmax
  182.               real(8) F
  183.               real(8) w(nmax,6)
  184.               INTEGER C
  185.               EXTERNAL F
  186.               LOGICAL RST
  187.         
  188.               real(8) UFLOW,EB,RABS,RAB,FMN,FMX,XM,EPMACH,R1MACH,UNI,RAV,TE1
  189.               real(8) FMINR,FMINL,FMAXR,FMAXL,TE2,TE,TR,TR2,TR1,T
  190.               integer I,IROFF,ISAMAX,LOC
  191.         
  192.         C      print *, 'inside q1dax'
  193.         C
  194.         C***FIRST EXECUTABLE STATEMENT  Q1DAX
  195.               EPMACH = epsilon(0.D0)
  196.               UFLOW = tiny(0.D0)
  197.               IF(A.EQ.B) THEN
  198.                   R=0.D0
  199.                   E=0.
  200.                   N_INT=0
  201.                   IFLAG=0
  202.                   KF=1
  203.                   FMIN=F(A)
  204.                   FMAX=FMIN
  205.                   GO TO 20
  206.               ENDIF
  207.               IF(RST) THEN
  208.                  IF(IFLAG.LT.3) THEN
  209.                    EB=MAX(100.D0*UFLOW,MAX(EPS,50.D0*EPMACH)*ABS(R))
  210.  Vr4--<            DO 19 I=1,N_INT
  211.  Vr4                   IF(ABS(W(I,3)).GT.(EB*(W(I,2)-W(I,1))/(B-A)))THEN
  212.  Vr4                                     W(I,3)=ABS(W(I,3))
  213.  Vr4                   ELSE
  214.  Vr4                                     W(I,3)=-ABS(W(I,3))
  215.  Vr4                   ENDIF
  216.  Vr4-->    19      CONTINUE
  217.                    GOTO 15
  218.                  ELSE
  219.                    GOTO 20
  220.                  ENDIF
  221.               ENDIF
  222.               KF=0
  223.               IF(EPS .LE. 0. .OR. N_INT .LE. 0 .OR. N_INT .GE. NMAX) THEN
  224.                   IFLAG=7
  225.                   GO TO 20
  226.               ENDIF
  227.               IF(N_INT.EQ.1)
  228.              1  THEN
  229.                   W(1,1)=A
  230.                   W(2,2)=B
  231.                   W(1,5)=A
  232.                   W(1,6)=B
  233.                   W(2,5)=A
  234.                   W(2,6)=B
  235.         C          SELECT FIRST SUBDIVISION RANDOMLY
  236.                   CALL RANDOM_NUMBER(UNI)
  237.                   W(1,2)=A+(B-A)/2.*(2*UNI+7.)/8.
  238.                   W(2,1)=W(1,2)
  239.                   N_INT=2
  240.                 ELSE
  241.                   IF(W(1,1).NE.A .OR. W(N_INT+1,1).NE.B) THEN
  242.                        IFLAG=8
  243.                        GO TO 20
  244.                   ENDIF
  245.                   W(1,5)=A
  246.  Vr4--<           DO 89 I=1,N_INT
  247.  Vr4                 W(I,2)=W(I+1,1)
  248.  Vr4                 W(I,5)=W(I,1)
  249.  Vr4                 W(I,6)=W(I,2)
  250.  Vr4-->    89     CONTINUE
  251.               ENDIF
  252.         C
  253.               IFLAG = 0
  254.               IROFF=0
  255.               RABS=0.0
  256.  1----<       DO 3 I=1,N_INT
  257.  1                CALL GL15T(F,W(I,1),W(I,2),W(I,5),W(I,6),
  258.  1           1          W(I,4),W(I,3),RAB,RAV,FMN,FMX)
  259.  1                KF=KF+15
