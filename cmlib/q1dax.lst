  304.              1                    TR1,TE1,RAB,RAV,FMINL,FMAXL)
  305.                     KF=KF+15
  306.                     IF (TE1.LT.(EB*(XM-W(LOC,1))/(B-A))) TE1=-TE1
  307.                     CALL GL15T(F,XM,W(LOC,2),W(LOC,5),W(LOC,6),
  308.              1                    TR2,TE2,RAB,RAV,FMINR,FMAXR)
  309.                     KF=KF+15
  310.                     FMIN=MIN(FMIN,FMINL,FMINR)
  311.                     FMAX=MAX(FMAX,FMAXL,FMAXR)
  312.                     IF (TE2.LT.(EB*(W(LOC,2)-XM)/(B-A))) TE2=-TE2
  313.                     TE = ABS(W(LOC,3))
  314.                     TR = W(LOC,4)
  315.                     W(C,3) = TE2
  316.                     W(C,4) = TR2
  317.                     W(C,1) = XM
  318.                     W(C,2) = W(LOC,2)
  319.                     W(C,5) = W(LOC,5)
  320.                     W(C,6) = W(LOC,6)
  321.                     W(LOC,3) = TE1
  322.                     W(LOC,4) = TR1
  323.                     W(LOC,2) = XM
  324.                     E = E-TE+(ABS(TE1)+ABS(TE2))
  325.                     R = R-TR+(TR1+TR2)
  326.                     IF(ABS(ABS(TE1)+ABS(TE2)-TE).LT.0.001*TE) THEN
  327.                         IROFF=IROFF+1
  328.                         IF(IROFF.GE.10) THEN
  329.                              IFLAG=4
  330.                              GO TO 20
  331.                         ENDIF
  332.                     ENDIF
  333.                   ELSE
  334.                     IF (EB.GT.W(LOC,3))
  335.              1         THEN
  336.                            W(LOC,3) = 0.
  337.                        ELSE
  338.                            IFLAG=6
  339.                            GO TO 20
  340.                     END IF
  341.               END IF
  342.               GO TO 15
  343.         C
  344.         C        ALL EXITS FROM HERE
  345.         C
  346.            20 CONTINUE
  347.               IF(IFLAG.GE.4)RETURN
  348.               IFLAG=3
  349.               T=EPS*ABS(R)
  350.               IF(E.GT.EPS .AND. E.GT.T)RETURN
  351.               IFLAG=2
  352.               IF(E.GT.EPS .AND. E.LT.T)RETURN
  353.               IFLAG=1
  354.               IF(E.LT.EPS .AND. E.GT.T)RETURN
  355.               IFLAG=0
  356.               RETURN
  357.               END

