  262.  1                     R=W(I,4)
  263.  1                     E=W(I,3)
  264.  1                     RABS=RABS+RAB
  265.  1                     FMIN=FMN
  266.  1                     FMAX=FMX
  267.  1                   ELSE
  268.  1                     R=R+W(I,4)
  269.  1                     E=E+W(I,3)
  270.  1                     RABS=RABS+RAB
  271.  1                     FMAX=MAX(FMAX,FMX)
  272.  1                     FMIN=MIN(FMIN,FMN)
  273.  1                ENDIF
  274.  1---->     3 CONTINUE
  275.  A----<       DO 10 I=N_INT+1,NMAX
  276.  A                W(I,3) = 0.
  277.  A---->    10 CONTINUE
  278.            15 CONTINUE
  279.         C
  280.         C   MAIN SUBPROGRAM LOOP
  281.         C
  282.               IF(100.D0*EPMACH*RABS.GE.ABS(R) .AND. E.LT.EPS)GO TO 20
  283.               EB=MAX(100.D0*UFLOW,MAX(EPS,50.D0*EPMACH)*ABS(R))
  284.               IF(E.LE.EB) GO TO 20
  285.               IF (N_INT.LT.NMAX)
  286.              1 THEN
  287.                 N_INT = N_INT+1
  288.                 C = N_INT
  289.                ELSE
  290.                 C=0
  291.            16   IF(C.EQ.NMAX) THEN
  292.                     IFLAG=5
  293.                     GO TO 20
  294.                 ENDIF
  295.                 C=C+1
  296.                 IF(W(C,3).GT.0.0) GO TO 16
  297.               END IF
  298.  I            LOC=ISAMAX(N_INT,W(1,3),1)
  299.               XM = W(LOC,1)+(W(LOC,2)-W(LOC,1))/2.
  300.               IF ((MAX(ABS(W(LOC,1)),ABS(W(LOC,2)))).GT.
  301.              1   ((1.D0+100.D0*EPMACH)*(ABS(XM)+0.1D+04*UFLOW)))
  302.              2    THEN
