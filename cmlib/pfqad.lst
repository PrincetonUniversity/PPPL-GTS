     %%%    L o o p m a r k   L e g e n d    %%%

     Primary Loop Type        Modifiers
     ------- ---- ----        ---------
     A - Pattern matched      a - atomic memory operation
                              b - blocked
     C - Collapsed            c - conditional and/or computed
     D - Deleted               
     E - Cloned               f - fused
     G - Accelerated          g - partitioned
     I - Inlined              i - interchanged
     M - Multithreaded        m - partitioned
                              n - non-blocking remote transfer
                              p - partial
                              r - unrolled
                              s - shortloop
     V - Vectorized           w - unwound


    1.             SUBROUTINE PFQAD(F,LDC,C,XI,LXI,K,ID,X1,X2,TOL,QUAD,IERR)
    2.       C***BEGIN PROLOGUE  PFQAD
    3.       C***DATE WRITTEN   800901   (YYMMDD)
    4.       C***REVISION DATE  820801   (YYMMDD)
    5.       C***CATEGORY NO.  H2A2A1,E3,K6
    6.       C***KEYWORDS  B-SPLINE,DATA FITTING,INTERPOLATION,QUADRATURE,SPLINE
    7.       C***AUTHOR  AMOS, D. E., (SNLA)
    8.       C***PURPOSE  Computes the integral on (X1,X2) of a product of a function
    9.       C            F and the ID-th derivative of a B-spline,
   10.       C            (PP-representation).
   11.       C***DESCRIPTION
   12.       C
   13.       C     Written by D. E. Amos, June, 1979.
   14.       C
   15.       C     Reference SAND-79-1825
   16.       C
   17.       C     Abstract
   18.       C         PFQAD computes the integral on (X1,X2) of a product of a
   19.       C         function F and the ID-th derivative of a B-spline, using the
   20.       C         PP-representation (C,XI,LXI,K). (X1,X2) is normally a sub-
   21.       C         interval of XI(1) .LE. X .LE. XI(LXI+1).  An integration rou-
   22.       C         tine, PPGQ8(a modification of GAUS8), integrates the product
   23.       C         on sub-intervals of (X1,X2) formed by the included break
   24.       C         points.  Integration outside of (XI(1),XI(LXI+1)) is permitted
   25.       C         provided F is defined.
   26.       C
   27.       C         PFQAD calls INTRV, PPVAL, PPGQ8, R1MACH, XERROR
   28.       C
   29.       C     Description of Arguments
   30.       C         Input
   31.       C           F      - external function of one argument for the
   32.       C                    integrand PF(X)=F(X)*PPVAL(LDC,C,XI,LXI,K,ID,X,
   33.       C                    INPPV)
   34.       C           LDC    - leading dimension of matrix C, LDC .GE. K
   35.       C           C(I,J) - right Taylor derivatives at XI(J), I=1,K , J=1,LXI
   36.       C           XI(*)  - break point array of length LXI+1
   37.       C           LXI    - number of polynomial pieces
   38.       C           K      - order of B-spline, K .GE. 1
   39.       C           ID     - order of the spline derivative, 0 .LE. ID .LE. K-1
   40.       C                    ID=0 gives the spline function
   41.       C           X1,X2  - end points of quadrature interval, normally in
   42.       C                    XI(1) .LE. X .LE. XI(LXI+1)
   43.       C           TOL    - desired accuracy for the quadrature, suggest
   44.       C                    10.*STOL .LT. TOL .LE. 0.1 where STOL is the single
   45.       C                    precision unit roundoff for the machine = R1MACH(4)
   46.       C
   47.       C         Output
   48.       C           QUAD   - integral of PF(X) on (X1,X2)
   49.       C           IERR   - a status code
   50.       C                    IERR=1 normal return
   51.       C                         2 some quadrature does not meet the
   52.       C                           requested tolerance
   53.       C
   54.       C     Error Conditions
   55.       C         TOL not greater than the single precision unit roundoff or
   56.       C         less than 0.1 is a fatal error.
   57.       C         Some quadrature does not meet the requested tolerance.
   58.       C***REFERENCES  D.E. AMOS, *QUADRATURE SUBROUTINES FOR SPLINES AND
   59.       C                 B-SPLINES*, SAND79-1825, SANDIA LABORATORIES,
   60.       C                 DECEMBER 1979.
   61.       C***ROUTINES CALLED  INTRV,PPGQ8,R1MACH,XERROR
   62.       C***END PROLOGUE  PFQAD
   63.       C
   64.       C
   65.             INTEGER ID,IERR,IFLG,ILO,IL1,IL2,INPPV,K,LDC,LEFT,LXI,MF1,MF2
   66.             REAL*8 A, AA, ANS, B, BB, Q, QUAD, TA, TB, TOL, WTOL, X1, X2
   67.             REAL*8 R1MACH, F
   68.             REAL*8 XI(1), C(LDC,1)
   69.             EXTERNAL F
   70.       C
   71.       C***FIRST EXECUTABLE STATEMENT  PFQAD
   72.             IERR = 1
   73.             QUAD = 0.0E0
   74.             IF(K.LT.1) GO TO 100
   75.             IF(LDC.LT.K) GO TO 105
   76.             IF(ID.LT.0 .OR. ID.GE.K) GO TO 110
   77.             IF(LXI.LT.1) GO TO 115
   78.             WTOL = R1MACH(4)
   79.             IF (TOL.LT.WTOL .OR. TOL.GT.0.1E0) GO TO 20
   80.             AA = MIN(X1,X2)
   81.             BB = MAX(X1,X2)
   82.             IF (AA.EQ.BB) RETURN
   83.             ILO = 1
   84.             CALL INTRV(XI, LXI, AA, ILO, IL1, MF1)
   85.             CALL INTRV(XI, LXI, BB, ILO, IL2, MF2)
   86.             Q = 0.0E0
   87.             INPPV = 1
   88.  1--<       DO 10 LEFT=IL1,IL2
   89.  1            TA = XI(LEFT)
   90.  1            A = MAX(AA,TA)
   91.  1            IF (LEFT.EQ.1) A = AA
   92.  1            TB = BB
   93.  1            IF (LEFT.LT.LXI) TB = XI(LEFT+1)
   94.  1            B = MIN(BB,TB)
   95.  1            CALL PPGQ8(F,LDC,C,XI,LXI,K,ID,A,B,INPPV,TOL,ANS,IFLG)
   96.  1            IF (IFLG.GT.1) IERR = 2
   97.  1            Q = Q + ANS
   98.  1-->    10 CONTINUE
   99.             IF (X1.GT.X2) Q = -Q
  100.             QUAD = Q
  101.             RETURN
  102.       C
  103.          20 CONTINUE
  104.             CALL XERROR( ' PFQAD,  TOL IS LESS THAN THE SINGLE PRECISION TOLER
  105.            1ANCE OR GREATER THAN 0.1', 76, 2, 1)
  106.             RETURN
  107.         100 CONTINUE
  108.             CALL XERROR( ' PFQAD,  K DOES NOT SATISFY K.GE.1', 34, 2, 1)
  109.             RETURN
  110.         105 CONTINUE
  111.             CALL XERROR( ' PFQAD,  LDC DOES NOT SATISFY LDC.GE.K', 38, 2, 1)
  112.             RETURN
  113.         110 CONTINUE
  114.             CALL XERROR( ' PFQAD,  ID DOES NOT SATISFY 0.LE.ID.LT.K', 41,
  115.            1 2, 1)
  116.             RETURN
  117.         115 CONTINUE
  118.             CALL XERROR( ' PFQAD,  LXI DOES NOT SATISFY LXI.GE.1', 38, 2, 1)
  119.             RETURN
  120.             END

