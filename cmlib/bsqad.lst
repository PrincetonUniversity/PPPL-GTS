    1.               SUBROUTINE BSQAD(T,BCOEF,N,K,X1,X2,BQUAD,WORK)
    2.         C***BEGIN PROLOGUE  BSQAD
    3.         C***DATE WRITTEN   800901   (YYMMDD)
    4.         C***REVISION DATE  820801   (YYMMDD)
    5.         C***CATEGORY NO.  H2A2A1,E3,K6
    6.         C***KEYWORDS  B-SPLINE,DATA FITTING,INTERPOLATION,QUADRATURE,SPLINE
    7.         C***AUTHOR  AMOS, D. E., (SNLA)
    8.         C***PURPOSE  Computes the integral on (X1,X2) of a K-th order
    9.         C            B-spline using the B-representation.
   10.         C***DESCRIPTION
   11.         C
   12.         C     Written by D. E. Amos, June, 1979.
   13.         C
   14.         C     Reference SAND 79-1825
   15.         C
   16.         C     Abstract
   17.         C         BSQAD computes the integral on (X1,X2) of a K-th order
   18.         C         B-spline using the B-representation (T,BCOEF,N,K).  Orders
   19.         C         K as high as 20 are permitted by applying a 2, 6, or 10
   20.         C         point Gauss formula on subintervals of (X1,X2) which are
   21.         C         formed by included (distinct) knots.
   22.         C
   23.         C         If orders K greater than 20 are needed, use BFQAD with
   24.         C         F(X) = 1.
   25.         C
   26.         C         BSQAD calls INTRV, BVALU, XERROR
   27.         C
   28.         C     Description of Arguments
   29.         C         Input
   30.         C           T      - knot array of length N+K
   31.         C           BCOEF  - B-spline coefficient array of length N
   32.         C           N      - length of coefficient array
   33.         C           K      - order of B-spline, 1 .LE. K .LE. 20
   34.         C           X1,X2  - end points of quadrature interval in
   35.         C                    T(K) .LE. X .LE. T(N+1)
   36.         C
   37.         C         Output
   38.         C           BQUAD  - integral of the B-spline over (X1,X2)
   39.         C           WORK   - work vector of length 3*K
   40.         C
   41.         C     Error Conditions
   42.         C         Improper input is a fatal error
   43.         C***REFERENCES  D.E. AMOS, *QUADRATURE SUBROUTINES FOR SPLINES AND
   44.         C                 B-SPLINES*, SAND79-1825, SANDIA LABORATORIES,
   45.         C                 DECEMBER 1979.
   46.         C***ROUTINES CALLED  BVALU,INTRV,XERROR
   47.         C***END PROLOGUE  BSQAD
   48.         C
   49.         C
   50.               INTEGER I,IL1,IL2,ILO,INBV, JF,K,LEFT,M,MF,MFLAG,N, NPK, NP1
   51.               REAL*8 A, AA, B, BB, BMA, BPA, BQUAD, C1, GX, Q,
   52.              1 TA, TB, X1, X2, Y1, Y2
   53.               REAL*8 BVALU
   54.               REAL*8 T(1), BCOEF(1), GPTS(9), GWTS(9), SUM(5), WORK(1)
   55.         C
   56.               DATA GPTS(1), GPTS(2), GPTS(3), GPTS(4), GPTS(5), GPTS(6),
   57.              1     GPTS(7), GPTS(8), GPTS(9)/
   58.              2     5.77350269189625764E-01,     2.38619186083196909E-01,
   59.              3     6.61209386466264514E-01,     9.32469514203152028E-01,
   60.              4     1.48874338981631211E-01,     4.33395394129247191E-01,
   61.              5     6.79409568299024406E-01,     8.65063366688984511E-01,
   62.              6     9.73906528517171720E-01/
   63.               DATA GWTS(1), GWTS(2), GWTS(3), GWTS(4), GWTS(5), GWTS(6),
   64.              1     GWTS(7), GWTS(8), GWTS(9)/
   65.              2     1.00000000000000000E+00,     4.67913934572691047E-01,
   66.              3     3.60761573048138608E-01,     1.71324492379170345E-01,
   67.              4     2.95524224714752870E-01,     2.69266719309996355E-01,
   68.              5     2.19086362515982044E-01,     1.49451349150580593E-01,
   69.              6     6.66713443086881376E-02/
   70.         C
   71.         C***FIRST EXECUTABLE STATEMENT  BSQAD
   72.               BQUAD = 0.0E0
   73.               IF(K.LT.1 .OR. K.GT.20) GO TO 65
   74.               IF(N.LT.K) GO TO 70
   75.               AA = MIN(X1,X2)
   76.               BB = MAX(X1,X2)
   77.               IF (AA.LT.T(K)) GO TO 60
   78.               NP1 = N + 1
   79.               IF (BB.GT.T(NP1)) GO TO 60
   80.               IF (AA.EQ.BB) RETURN
   81.               NPK = N + K
   82.         C     SELECTION OF 2, 6, OR 10 POINT GAUSS FORMULA
   83.               JF = 0
   84.               MF = 1
   85.               IF (K.LE.4) GO TO 10
   86.               JF = 1
   87.               MF = 3
   88.               IF (K.LE.12) GO TO 10
   89.               JF = 4
   90.               MF = 5
   91.            10 CONTINUE
   92.         C
   93.  V----<       DO 20 I=1,MF
   94.  V              SUM(I) = 0.0E0
   95.  V---->    20 CONTINUE
   96.               ILO = 1
   97.               INBV = 1
   98.               CALL INTRV(T, NPK, AA, ILO, IL1, MFLAG)
   99.               CALL INTRV(T, NPK, BB, ILO, IL2, MFLAG)
  100.               IF (IL2.GE.NP1) IL2 = N
  101.  1----<       DO 40 LEFT=IL1,IL2
  102.  1              TA = T(LEFT)
  103.  1              TB = T(LEFT+1)
  104.  1              IF (TA.EQ.TB) GO TO 40
  105.  1              A = MAX(AA,TA)
  106.  1              B = MIN(BB,TB)
  107.  1              BMA = 0.5E0*(B-A)
  108.  1              BPA = 0.5E0*(B+A)
  109.  1 2--<         DO 30 M=1,MF
  110.  1 2              C1 = BMA*GPTS(JF+M)
  111.  1 2              GX = -C1 + BPA
  112.  1 2              Y2 = BVALU(T,BCOEF,N,K,0,GX,INBV,WORK)
  113.  1 2              GX = C1 + BPA
  114.  1 2              Y1 = BVALU(T,BCOEF,N,K,0,GX,INBV,WORK)
  115.  1 2              SUM(M) = SUM(M) + (Y1+Y2)*BMA
  116.  1 2-->    30   CONTINUE
  117.  1---->    40 CONTINUE
  118.               Q = 0.0E0
  119.  V----<       DO 50 M=1,MF
  120.  V              Q = Q + GWTS(JF+M)*SUM(M)
  121.  V---->    50 CONTINUE
  122.               IF (X1.GT.X2) Q = -Q
  123.               BQUAD = Q
  124.               RETURN
  125.         C
  126.         C
  127.            60 CONTINUE
  128.               CALL XERROR( ' BSQAD,  X1 OR X2 OR BOTH DO NOT SATISFY T(K).LE.X.L
  129.              1E.T(N+1)',   60, 2, 1)
  130.               RETURN
  131.            65 CONTINUE
  132.               CALL XERROR( ' BSQAD,  K DOES NOT SATISFY 1.LE.K.LE.20',
  133.              1 40, 2, 1)
  134.               RETURN
  135.            70 CONTINUE
  136.               CALL XERROR( ' BSQAD,  N DOES NOT SATISFY N.GE.K', 34, 2, 1)
  137.               RETURN
  138.               END

