    1.             INTEGER FUNCTION ISAMAX(N,SX,INCX)
    2.       C***BEGIN PROLOGUE  ISAMAX
    3.       C***DATE WRITTEN   791001   (YYMMDD)
    4.       C***REVISION DATE  820801   (YYMMDD)
    5.       C***CATEGORY NO.  D1A2
    6.       C***KEYWORDS  BLAS,LINEAR ALGEBRA,MAXIMUM COMPONENT,VECTOR
    7.       C***AUTHOR  LAWSON, C. L., (JPL)
    8.       C           HANSON, R. J., (SNLA)
    9.       C           KINCAID, D. R., (U. OF TEXAS)
   10.       C           KROGH, F. T., (JPL)
   11.       C***PURPOSE  Find largest component of s.p. vector
   12.       C***DESCRIPTION
   13.       C
   14.       C                B L A S  Subprogram
   15.       C    Description of Parameters
   16.       C
   17.       C     --Input--
   18.       C        N  number of elements in input vector(s)
   19.       C       SX  single precision vector with N elements
   20.       C     INCX  storage spacing between elements of SX
   21.       C
   22.       C     --Output--
   23.       C   ISAMAX  smallest index (zero if N .LE. 0)
   24.       C
   25.       C     Find smallest index of maximum magnitude of single precision SX.
   26.       C     ISAMAX =  first I, I = 1 to N, to minimize  ABS(SX(1-INCX+I*INCX)
   27.       C***REFERENCES  LAWSON C.L., HANSON R.J., KINCAID D.R., KROGH F.T.,
   28.       C                 *BASIC LINEAR ALGEBRA SUBPROGRAMS FOR FORTRAN USAGE*,
   29.       C                 ALGORITHM NO. 539, TRANSACTIONS ON MATHEMATICAL
   30.       C                 SOFTWARE, VOLUME 5, NUMBER 3, SEPTEMBER 1979, 308-323
   31.       C***ROUTINES CALLED  (NONE)
   32.       C***END PROLOGUE  ISAMAX
   33.       C
   34.             implicit none
   35.             REAL*8 SX(1),SMAX,XMAG
   36.             INTEGER INCX,N,NS,II,I
   37.       C***FIRST EXECUTABLE STATEMENT  ISAMAX
   38.             ISAMAX = 0
   39.             IF(N.LE.0) RETURN
   40.             ISAMAX = 1
   41.             IF(N.LE.1)RETURN
   42.             IF(INCX.EQ.1)GOTO 20
   43.       C
   44.       C        CODE FOR INCREMENTS NOT EQUAL TO 1.
   45.       C
   46.             SMAX = ABS(SX(1))
   47.             NS = N*INCX
   48.             II = 1
   49.  1--<           DO 10 I=1,NS,INCX
   50.  1              XMAG = ABS(SX(I))
   51.  1              IF(XMAG.LE.SMAX) GO TO 5
   52.  1              ISAMAX = II
   53.  1              SMAX = XMAG
   54.  1        5     II = II + 1
   55.  1-->    10     CONTINUE
   56.             RETURN
   57.       C
   58.       C        CODE FOR INCREMENTS EQUAL TO 1.
   59.       C
   60.          20 SMAX = ABS(SX(1))
   61.  1--<       DO 30 I = 2,N
   62.  1             XMAG = ABS(SX(I))
   63.  1             IF(XMAG.LE.SMAX) GO TO 30
   64.  1             ISAMAX = I
   65.  1             SMAX = XMAG
   66.  1-->    30 CONTINUE
   67.             RETURN
   68.             END

