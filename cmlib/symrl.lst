     %%%    L o o p m a r k   L e g e n d    %%%

     Primary Loop Type        Modifiers
     ------- ---- ----        ---------
     A - Pattern matched      a - atomic memory operation
                              b - blocked
     C - Collapsed            c - conditional and/or computed
     D - Deleted               
     E - Cloned               f - fused
     G - Accelerated          g - partitioned
     I - Inlined              i - interchanged
     M - Multithreaded        m - partitioned
                              n - non-blocking remote transfer
                              p - partial
                              r - unrolled
                              s - shortloop
     V - Vectorized           w - unwound


    1.                SUBROUTINE SYMRL(S, CENTER, HWIDTH, F, MINORD, MAXORD, INTVLS,
    2.               * INTCLS, NUMSMS, WEGHTS, FULSMS, FAIL)
    3.          C  MULTIDIMENSIONAL FULLY SYMMETRIC RULE INTEGRATION SUBROUTINE
    4.          C
    5.          C   THIS SUBROUTINE COMPUTES A SEQUENCE OF FULLY SYMMETRIC RULE
    6.          C   APPROXIMATIONS TO A FULLY SYMMETRIC MULTIPLE INTEGRAL.
    7.          C   WRITTEN BY A. GENZ, MATHEMATICAL INSTITUTE, UNIVERSITY OF KENT,
    8.          C   CANTERBURY, KENT CT2 7NF, ENGLAND
    9.          C
   10.          C**************  PARAMETERS FOR SYMRL  ********************************
   11.          C*****INPUT PARAMETERS
   12.          C  S       INTEGER NUMBER OF VARIABLES, MUST EXCEED 0 BUT NOT EXCEED 20
   13.          C  F       EXTERNALLY DECLARED USER DEFINED REAL FUNCTION INTEGRAND.
   14.          C          IT MUST HAVE PARAMETERS (S,X), WHERE X IS A REAL ARRAY
   15.          C          WITH DIMENSION S.
   16.          C  MINORD  INTEGER MINIMUM ORDER PARAMETER.  ON ENTRY MINORD SPECIFIES
   17.          C          THE CURRENT HIGHEST ORDER APPROXIMATION TO THE INTEGRAL,
   18.          C          AVAILABLE IN THE ARRAY INTVLS.  FOR THE FIRST CALL OF SYMRL
   19.          C          MINORD SHOULD BE SET TO 0.  OTHERWISE A PREVIOUS CALL IS
   20.          C          ASSUMED THAT COMPUTED INTVLS(1), ... , INTVLS(MINORD).
   21.          C          ON EXIT MINORD IS SET TO MAXORD.
   22.          C  MAXORD  INTEGER MAXIMUM ORDER PARAMETER, MUST BE GREATER THAN MINORD
   23.          C          AND NOT EXCEED 20. THE SUBROUTINE COMPUTES INTVLS(MINORD+1),
   24.          C          INTVLS(MINORD+2),..., INTVLS(MAXORD).
   25.          C  G       REAL ARRAY OF DIMENSION(MAXORD) OF GENERATORS.
   26.          C          ALL GENERATORS MUST BE DISTINCT AND NONNEGATIVE.
   27.          C  NUMSMS  INTEGER LENGTH OF ARRAY FULSMS, MUST BE AT LEAST THE SUM OF
   28.          C          THE NUMBER OF DISTINCT PARTITIONS OF LENGTH AT MOST S
   29.          C          OF THE INTEGERS 0,1,...,MAXORD-1.  AN UPPER BOUND FOR NUMSMS
   30.          C          WHEN S+MAXORD IS LESS THAN 19 IS 200
   31.          C******OUTPUT PARAMETERS
   32.          C  INTVLS  REAL ARRAY OF DIMENSION(MAXORD).  UPON SUCCESSFUL EXIT
   33.          C          INTVLS(1), INTVLS(2),..., INTVLS(MAXORD) ARE APPROXIMATIONS
   34.          C          TO THE INTEGRAL.  INTVLS(D+1) WILL BE AN APPROXIMATION OF
   35.          C          POLYNOMIAL DEGREE 2D+1.
   36.          C  INTCLS  INTEGER TOTAL NUMBER OF F VALUES NEEDED FOR INTVLS(MAXORD)
   37.          C  WEGHTS  REAL WORKING STORAGE ARRAY WITH DIMENSION (NUMSMS). ON EXIT
   38.          C          WEGHTS(J) CONTAINS THE WEIGHT FOR FULSMS(J).
   39.          C  FULSMS  REAL WORKING STORAGE ARRAY WITH DIMENSION (NUMSMS). ON EXIT
   40.          C          FULSMS(J) CONTAINS THE FULLY SYMMETRIC BASIC RULE SUM
   41.          C          INDEXED BY THE JTH S-PARTITION OF THE INTEGERS
   42.          C          0,1,...,MAXORD-1.
   43.          C  FAIL    INTEGER FAILURE OUTPUT PARAMETER
   44.          C          FAIL=0 FOR SUCCESSFUL TERMINATION OF THE SUBROUTINE
   45.          C          FAIL=1 WHEN NUMSMS IS TOO SMALL FOR THE SUBROUTINE TO
   46.          C                  CONTINUE.  IN THIS CASE WEGHTS(1), WEGHTS(2), ...,
   47.          C                  WEGHTS(NUMSMS), FULSMS(1), FULSMS(2), ...,
   48.          C                  FULSMS(NUMSMS) AND INTVLS(1), INTVLS(2),...,
   49.          C                  INTVLS(J) ARE RETURNED, WHERE J IS MAXIMUM VALUE OF
   50.          C                  MAXORD COMPATIBLE WITH THE GIVEN VALUE OF NUMSMS.
   51.          C          FAIL=2 WHEN PARAMETERS S,MINORD, MAXORD OR G ARE OUT OF
   52.          C                  RANGE
   53.          C***********************************************************************
   54.                implicit none
   55.                EXTERNAL F
   56.          C***  FOR DOUBLE PRECISION CHANGE REAL TO DOUBLE PRECISION
   57.          C      IN THE NEXT STATEMENT
   58.                INTEGER D, I, FAIL, K(20), INTCLS, PRTCNT, L, M(20), MAXORD,
   59.               * MINORD, MODOFM, NUMSMS, S, SUMCLS, MAXRDM, MAXS, HUNDRD, FLOATL
   60.                REAL*8 INTVLS(MAXORD), CENTER(S), HWIDTH(S), GISQRD, GLSQRD,
   61.               * INTMPA, INTMPB, INTVAL, ONE, FULSMS(NUMSMS), WEGHTS(NUMSMS),
   62.               * TWO, MOMTOL, MOMNKN, MOMPRD(20,20), MOMENT(20), ZERO, G(20),
   63.               * F, FLSM, WHT, FULWGT
   64.          C       PATTERSON GENERATORS
   65.                DATA G(1), G(2) /0.0000000000000000,0.7745966692414833/
   66.                DATA G(3), G(4) /0.9604912687080202,0.4342437493468025/
   67.                DATA G(5), G(6) /0.9938319632127549,0.8884592328722569/
   68.                DATA G(7), G(8) /0.6211029467372263,0.2233866864289668/
   69.                DATA G(9), G(10), G(11), G(12) /0.1, 0.2, 0.3, 0.4/
   70.          C
   71.          C***  PARAMETER CHECKING AND INITIALISATION
   72.                FAIL = 2
   73.                MAXRDM = 20
   74.                MAXS = 20
   75.                IF (S.GT.MAXS .OR. S.LT.1) RETURN
   76.                IF (MINORD.LT.0 .OR. MINORD.GE.MAXORD) RETURN
   77.                IF (MAXORD.GT.MAXRDM) RETURN
   78.                ZERO = 0
   79.                ONE = 1
   80.                TWO = 2
   81.                MOMTOL = ONE
   82.             10 MOMTOL = MOMTOL/TWO
   83.                IF (MOMTOL+ONE.GT.ONE) GO TO 10
   84.                HUNDRD = 100
   85.                MOMTOL = HUNDRD*TWO*MOMTOL
   86.                D = MINORD
   87.                IF (D.EQ.0) INTCLS = 0
   88.          C***  CALCULATE MOMENTS AND MODIFIED MOMENTS
   89.  Vr2---<       DO 20 L=1,MAXORD
   90.  Vr2             FLOATL = L + L - 1
   91.  Vr2             MOMENT(L) = TWO/FLOATL
   92.  Vr2--->    20 CONTINUE
   93.                IF (MAXORD.EQ.1) GO TO 50
   94.  1-----<       DO 40 L=2,MAXORD
   95.  1               INTMPA = MOMENT(L-1)
   96.  1               GLSQRD = G(L-1)**2
   97.  1 r4--<         DO 30 I=L,MAXORD
   98.  1 r4              INTMPB = MOMENT(I)
   99.  1 r4              MOMENT(I) = MOMENT(I) - GLSQRD*INTMPA
  100.  1 r4              INTMPA = INTMPB
  101.  1 r4-->    30   CONTINUE
  102.  1               IF (MOMENT(L)**2.LT.(MOMTOL*MOMENT(1))**2) MOMENT(L) = ZERO
  103.  1----->    40 CONTINUE
  104.  w-----<    50 DO 70 L=1,MAXORD
  105.  w               IF (G(L).LT.ZERO) RETURN
  106.  w               MOMNKN = ONE
  107.  w               MOMPRD(L,1) = MOMENT(1)
  108.  w               IF (MAXORD.EQ.1) GO TO 70
  109.  w               GLSQRD = G(L)**2
  110.  w 2---<         DO 60 I=2,MAXORD
  111.  w 2               IF (I.LE.L) GISQRD = G(I-1)**2
  112.  w 2               IF (I.GT.L) GISQRD = G(I)**2
  113.  w 2               IF (GLSQRD.EQ.GISQRD) RETURN
  114.  w 2               MOMNKN = MOMNKN/(GLSQRD-GISQRD)
  115.  w 2               MOMPRD(L,I) = MOMNKN*MOMENT(I)
  116.  w 2--->    60   CONTINUE
  117.  w----->    70 CONTINUE
  118.                FAIL = 1
  119.          C
  120.          C***  BEGIN LOOP FOR EACH D
  121.          C      FOR EACH D FIND ALL DISTINCT PARTITIONS M WITH MOD(M))=D
  122.          C
  123.             80 PRTCNT = 0
  124.                INTVAL = ZERO
  125.                MODOFM = 0
  126.                CALL NXPRT(PRTCNT, S, M)
  127.             90 IF (PRTCNT.GT.NUMSMS) RETURN
  128.          C
  129.          C***  CALCULATE WEIGHT FOR PARTITION M AND FULLY SYMMETRIC SUMS
  130.          C***     WHEN NECESSARY
  131.          C
  132.                IF (D.EQ.MODOFM) WEGHTS(PRTCNT) = ZERO
  133.                IF (D.EQ.MODOFM) FULSMS(PRTCNT) = ZERO
  134.                FULWGT = WHT(S,MOMENT,M,K,MODOFM,D,MAXRDM,MOMPRD)
  135.                SUMCLS = 0
  136.                IF (WEGHTS(PRTCNT).EQ.ZERO .AND. FULWGT.NE.ZERO) FULSMS(PRTCNT) =
  137.               * FLSM(S, CENTER, HWIDTH, MOMENT, M, K, MAXORD, G, F, SUMCLS)
  138.                INTCLS = INTCLS + SUMCLS
  139.                INTVAL = INTVAL + FULWGT*FULSMS(PRTCNT)
  140.                WEGHTS(PRTCNT) = WEGHTS(PRTCNT) + FULWGT
  141.                CALL NXPRT(PRTCNT, S, M)
  142.                IF (M(1).GT.MODOFM) MODOFM = MODOFM + 1
  143.                IF (MODOFM.LE.D) GO TO 90
  144.          C
  145.          C***  END LOOP FOR EACH D
  146.                IF (D.GT.0) INTVAL = INTVLS(D) + INTVAL
  147.                INTVLS(D+1) = INTVAL
  148.                D = D + 1
  149.                IF (D.LT.MAXORD) GO TO 80
  150.          C
  151.          C***  SET FAILURE PARAMETER AND RETURN
  152.                FAIL = 0
  153.                MINORD = MAXORD
  154.                RETURN
  155.                END

