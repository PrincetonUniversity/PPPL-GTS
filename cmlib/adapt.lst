     %%%    L o o p m a r k   L e g e n d    %%%

     Primary Loop Type        Modifiers
     ------- ---- ----        ---------
     A - Pattern matched      a - atomic memory operation
                              b - blocked
     C - Collapsed            c - conditional and/or computed
     D - Deleted               
     E - Cloned               f - fused
     G - Accelerated          g - partitioned
     I - Inlined              i - interchanged
     M - Multithreaded        m - partitioned
                              n - non-blocking remote transfer
                              p - partial
                              r - unrolled
                              s - shortloop
     V - Vectorized           w - unwound


    1.                SUBROUTINE ADAPT(NDIM,A,B,MINPTS,MAXPTS,FUNCTN,EPS,RELERR,LENWRK,
    2.               * WRKSTR,FINEST,IFAIL)
    3.          C***BEGIN PROLOGUE ADAPT
    4.          C  ADAPTIVE MULTIDIMENSIONAL INTEGRATION SUBROUTINE
    5.          C           AUTHOR: A. C. GENZ, Washington State University
    6.          C                    19 March 1984
    7.          C**************  PARAMETERS FOR ADAPT  ********************************
    8.          C***** INPUT PARAMETERS
    9.          C  NDIM    NUMBER OF VARIABLES, MUST EXCEED 1, BUT NOT EXCEED 20
   10.          C  A       REAL ARRAY OF LOWER LIMITS, WITH DIMENSION NDIM
   11.          C  B       REAL ARRAY OF UPPER LIMITS, WITH DIMENSION NDIM
   12.          C  MINPTS  MINIMUM NUMBER OF FUNCTION EVALUATIONS TO BE ALLOWED.
   13.          C          ON THE FIRST CALL TO ADAPT MINPTS SHOULD BE SET TO A
   14.          C          NON NEGATIVE VALUE. (CAUTION... MINPTS IS ALTERED BY ADAPT)
   15.          C          IT IS POSSIBLE TO CONTINUE A CALCULATION TO GREATER ACCURACY
   16.          C          BY CALLING ADAPT AGAIN BY DECREASING EPS (DESCRIBED BELOW)
   17.          C          AND RESETTING MINPTS TO ANY NEGATIVE VALUE.
   18.          C          MINPTS MUST NOT EXCEED MAXPTS.
   19.          C  MAXPTS  MAXIMUM NUMBER OF FUNCTION EVALUATIONS TO BE ALLOWED,
   20.          C          WHICH MUST BE AT LEAST RULCLS, WHERE
   21.          C          RULCLS =  2**NDIM+2*NDIM**2+6*NDIM+1
   22.          C
   23.          C            FOR NDIM =  2   3   4   5   6   7   8   9   10
   24.          C            MAXPTS >=  25  45  73 113 173 269 433 729 1285
   25.          C         A suggested value for MAXPTS is 100 times the above values.
   26.          C
   27.          C  FUNCTN  EXTERNALLY DECLARED USER DEFINED FUNCTION TO BE INTEGRATED.
   28.          C          IT MUST HAVE PARAMETERS (NDIM,Z), WHERE Z IS A REAL ARRAY
   29.          C          OF DIMENSION NDIM.
   30.          C  EPS     REQUIRED RELATIVE ACCURACY
   31.          C  LENWRK  LENGTH OF ARRAY WRKSTR OF WORKING STORAGE, THE ROUTINE
   32.          C          NEEDS (2*NDIM+3)*(1+MAXPTS/RULCLS)/2 FOR LENWRK IF
   33.          C          MAXPTS FUNCTION CALLS ARE USED.
   34.          C          FOR GUIDANCE, IF YOU SET MAXPTS TO 100*RULCLS (SEE TABLE
   35.          C          ABOVE) THEN ACCEPTABLE VALUES FOR LENWRK ARE
   36.          C
   37.          C            FOR NDIM = 2    3    4    5    6    7    8     9
   38.          C            LENWRK =  357  561  1785 3417 6681 13209 26265 52377
   39.          C
   40.          C***** OUTPUT PARAMETERS
   41.          C  MINPTS  ACTUAL NUMBER OF FUNCTION EVALUATIONS USED BY ADAPT
   42.          C  WRKSTR  REAL ARRAY OF WORKING STORAGE OF DIMENSION (LENWRK).
   43.          C  RELERR  ESTIMATED RELATIVE ACCURACY OF FINEST
   44.          C  FINEST  ESTIMATED VALUE OF INTEGRAL
   45.          C  IFAIL   IFAIL=0 FOR NORMAL EXIT, WHEN ESTIMATED RELATIVE ACCURACY
   46.          C                  RELERR IS LESS THAN EPS WITH MAXPTS OR LESS FUNCTION
   47.          C                  CALLS MADE.
   48.          C          IFAIL=1 IF MAXPTS WAS TOO SMALL FOR ADAPT TO OBTAIN THE
   49.          C                  REQUIRED RELATIVE ACCURACY EPS.  IN THIS CASE ADAPT
   50.          C                  RETURNS A VALUE OF FINEST WITH ESTIMATED RELATIVE
   51.          C                  ACCURACY RELERR.
   52.          C          IFAIL=2 IF LENWRK TOO SMALL FOR MAXPTS FUNCTION CALLS.  IN
   53.          C                  THIS CASE ADAPT RETURNS A VALUE OF FINEST WITH
   54.          C                  ESTIMATED ACCURACY RELERR USING THE WORKING STORAGE
   55.          C                  AVAILABLE, BUT RELERR WILL BE GREATER THAN EPS.
   56.          C          IFAIL=3 IF NDIM ) 2, NDIM \ 20, MINPTS \ MAXPTS,
   57.          C                  OR MAXPTS ) RULCLS.
   58.          C***********************************************************************
   59.          C***END PROLOGUE ADAPT
   60.                implicit none
   61.                EXTERNAL FUNCTN
   62.          C*****  FOR DOUBLE PRECISION CHANGE REAL TO DOUBLE PRECISION IN THE
   63.          C        NEXT STATEMENT.
   64.                REAL*8 A(NDIM), B(NDIM), CENTER(20),
   65.               * DIFMAX, EPS, ERRMIN, FINEST, HALF,
   66.               * ONE, RELERR, RGNERR, RGNVAL, FUNCTN,
   67.               * TWO, WIDTH(20), WRKSTR(LENWRK), ZERO
   68.                INTEGER DIVAXO, DIVAXN, DIVFLG, FUNCLS, IFAIL, INDEX1,
   69.               * INDEX2, J, K, LENWRK, MAXCLS, MAXPTS, MINPTS, NDIM,
   70.               * RGNSTR, RULCLS, SBRGNS, SBTMPP, SUBRGN, SUBTMP
   71.                IFAIL=3
   72.                RELERR=1
   73.                FUNCLS=0
   74.                IF(NDIM.LT.2.OR.NDIM.GT.20) GOTO 300
   75.                IF(MINPTS.GT.MAXPTS) GOTO 300
   76.          C
   77.          C*****  INITIALISATION OF SUBROUTINE
   78.          C
   79.                ZERO=0
   80.                ONE=1
   81.                TWO=2
   82.                HALF=ONE/TWO
   83.                RGNSTR=2*NDIM+3
   84.                ERRMIN = ZERO
   85.                MAXCLS =  2**NDIM+2*NDIM**2+6*NDIM+1
   86.                MAXCLS = MIN0(MAXCLS,MAXPTS)
   87.                DIVAXO=0
   88.          C
   89.          C*****  END SUBROUTINE INITIALISATION
   90.                IF(MINPTS.LT.0) SBRGNS=WRKSTR(LENWRK-1)
   91.                IF(MINPTS.LT.0) GOTO 280
   92.  Vr4---<       DO 30 J=1,NDIM
   93.  Vr4             WIDTH(J)=(B(J)-A(J))*HALF
   94.  Vr4--->    30   CENTER(J)=A(J)+WIDTH(J)
   95.                FINEST=ZERO
   96.                WRKSTR(LENWRK)=ZERO
   97.                DIVFLG=1
   98.                SUBRGN=RGNSTR
   99.                SBRGNS=RGNSTR
  100.             40 CALL BSRL(NDIM,CENTER,WIDTH,FUNCTN,MAXCLS,RULCLS,
  101.               *            ERRMIN,RGNERR,RGNVAL,DIVAXO,DIVAXN)
  102.                FINEST=FINEST+RGNVAL
  103.                WRKSTR(LENWRK)=WRKSTR(LENWRK)+RGNERR
  104.                FUNCLS = FUNCLS + RULCLS
  105.          C
  106.          C*****  PLACE RESULTS OF BASIC RULE INTO PARTIALLY ORDERED LIST
  107.          C*****  ACCORDING TO SUBREGION ERROR
  108.                IF(DIVFLG.EQ.1) GO TO 230
  109.          C
  110.          C*****  WHEN DIVFLG=0 START AT TOP OF LIST AND MOVE DOWN LIST TREE TO
  111.          C       FIND CORRECT POSITION FOR RESULTS FROM FIRST HALF OF RECENTLY
  112.          C       DIVIDED SUBREGION
  113.            200 SUBTMP=2*SUBRGN
  114.                IF(SUBTMP.GT.SBRGNS) GO TO 250
  115.                 IF(SUBTMP.EQ.SBRGNS) GO TO 210
  116.                 SBTMPP=SUBTMP+RGNSTR
  117.                 IF(WRKSTR(SUBTMP).LT.WRKSTR(SBTMPP)) SUBTMP=SBTMPP
  118.            210  IF(RGNERR.GE.WRKSTR(SUBTMP)) GO TO 250
  119.  Vcr4--<         DO 220 K=1,RGNSTR
  120.  Vcr4              INDEX1=SUBRGN-K+1
  121.  Vcr4              INDEX2=SUBTMP-K+1
  122.  Vcr4-->   220     WRKSTR(INDEX1)=WRKSTR(INDEX2)
  123.                  SUBRGN=SUBTMP
  124.                GOTO 200
  125.          C
  126.          C*****  WHEN DIVFLG=1 START AT BOTTOM RIGHT BRANCH AND MOVE UP LIST
  127.          C       TREE TO FIND CORRECT POSITION FOR RESULTS FROM SECOND HALF OF
  128.          C       RECENTLY DIVIDED SUBREGION
  129.            230 SUBTMP=(SUBRGN/(RGNSTR*2))*RGNSTR
  130.                IF(SUBTMP.LT.RGNSTR) GO TO 250
  131.                IF(RGNERR.LE.WRKSTR(SUBTMP)) GO TO 250
  132.  Vcr4--<        DO 240 K=1,RGNSTR
  133.  Vcr4             INDEX1=SUBRGN-K+1
  134.  Vcr4             INDEX2=SUBTMP-K+1
  135.  Vcr4-->   240    WRKSTR(INDEX1)=WRKSTR(INDEX2)
  136.                 SUBRGN=SUBTMP
  137.                GOTO 230
  138.          C*****  STORE RESULTS OF BASIC RULE IN CORRECT POSITION IN LIST
  139.            250 WRKSTR(SUBRGN)=RGNERR
  140.                WRKSTR(SUBRGN-1)=RGNVAL
  141.                WRKSTR(SUBRGN-2)=DIVAXN
  142.  r8----<       DO 260 J=1,NDIM
  143.  r8              SUBTMP=SUBRGN-2*(J+1)
  144.  r8              WRKSTR(SUBTMP+1)=CENTER(J)
  145.  r8---->   260   WRKSTR(SUBTMP)=WIDTH(J)
  146.                IF(DIVFLG.EQ.1) GO TO 270
  147.          C*****  WHEN DIVFLG=0 PREPARE FOR SECOND APPLICATION OF BASIC RULE
  148.                CENTER(DIVAXO)=CENTER(DIVAXO)+TWO*WIDTH(DIVAXO)
  149.                SBRGNS=SBRGNS+RGNSTR
  150.                SUBRGN=SBRGNS
  151.                DIVFLG=1
  152.          C*****  LOOP BACK TO APPLY BASIC RULE TO OTHER HALF OF SUBREGION
  153.                GO TO 40
  154.          C
  155.          C*****  END ORDERING AND STORAGE OF BASIC RULE RESULTS
  156.          C*****  MAKE CHECKS FOR POSSIBLE TERMINATION OF ROUTINE
  157.          C
  158.          C******  FOR DOUBLE PRECISION CHANGE ABS TO DABS IN THE NEXT STATEMENT
  159.            270 RELERR=ONE
  160.                IF(WRKSTR(LENWRK).LE.ZERO) WRKSTR(LENWRK)=ZERO
  161.                IF(ABS(FINEST).NE.ZERO) RELERR=WRKSTR(LENWRK)/ABS(FINEST)
  162.                IF(RELERR.GT.ONE) RELERR=ONE
  163.                IF(SBRGNS+RGNSTR.GT.LENWRK-2) IFAIL=2
  164.                IF(FUNCLS+FUNCLS*RGNSTR/SBRGNS.GT.MAXPTS) IFAIL=1
  165.                IF(RELERR.LT.EPS.AND.FUNCLS.GE.MINPTS) IFAIL=0
  166.                IF(IFAIL.LT.3) GOTO 300
  167.          C
  168.          C*****  PREPARE TO USE BASIC RULE ON EACH HALF OF SUBREGION WITH LARGEST
  169.          C       ERROR
  170.            280 DIVFLG=0
  171.                SUBRGN=RGNSTR
  172.                SUBTMP = 2*SBRGNS/RGNSTR
  173.                MAXCLS = MAXPTS/SUBTMP
  174.                ERRMIN = ABS(FINEST)*EPS/FLOAT(SUBTMP)
  175.                WRKSTR(LENWRK)=WRKSTR(LENWRK)-WRKSTR(SUBRGN)
  176.                FINEST=FINEST-WRKSTR(SUBRGN-1)
  177.                DIVAXO=WRKSTR(SUBRGN-2)
  178.  r8----<       DO 290 J=1,NDIM
  179.  r8              SUBTMP=SUBRGN-2*(J+1)
  180.  r8              CENTER(J)=WRKSTR(SUBTMP+1)
  181.  r8---->   290   WIDTH(J)=WRKSTR(SUBTMP)
  182.                WIDTH(DIVAXO)=WIDTH(DIVAXO)*HALF
  183.                CENTER(DIVAXO)=CENTER(DIVAXO)-WIDTH(DIVAXO)
  184.          C
  185.          C*****  LOOP BACK TO APPLY BASIC RULE
  186.          C
  187.                GOTO 40
  188.          C
  189.          C*****  TERMINATION POINT
  190.          C
  191.            300 MINPTS=FUNCLS
  192.                WRKSTR(LENWRK-1)=SBRGNS
  193.                RETURN
  194.                END

