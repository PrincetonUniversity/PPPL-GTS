    1.                    SUBROUTINE BSPVD(T,K,NDERIV,X,ILEFT,LDVNIK,VNIKX,WORK)
    2.              C***BEGIN PROLOGUE  BSPVD
    3.              C***DATE WRITTEN   800901   (YYMMDD)
    4.              C***REVISION DATE  820801   (YYMMDD)
    5.              C***CATEGORY NO.  E3,K6
    6.              C***KEYWORDS  B-SPLINE,DATA FITTING,INTERPOLATION,SPLINE
    7.              C***AUTHOR  AMOS, D. E., (SNLA)
    8.              C***PURPOSE  Calculates the value and all derivatives of order less than
    9.              C            NDERIV of all basis functions which do not vanish at X.
   10.              C***DESCRIPTION
   11.              C
   12.              C     Written by Carl de Boor and modified by D. E. Amos
   13.              C
   14.              C     Reference
   15.              C         SIAM J. Numerical Analysis, 14, No. 3, June, 1977, pp.441-472.
   16.              C
   17.              C     Abstract
   18.              C         BSPVD is the BSPLVD routine of the reference.
   19.              C
   20.              C         BSPVD calculates the value and all derivatives of order
   21.              C         less than NDERIV of all basis functions which do not
   22.              C         (possibly) vanish at X.  ILEFT is input such that
   23.              C         T(ILEFT) .LE. X .LT. T(ILEFT+1).  A call to INTRV(T,N+1,X,
   24.              C         ILO,ILEFT,MFLAG) will produce the proper ILEFT.  The output of
   25.              C         BSPVD is a matrix VNIKX(I,J) of dimension at least (K,NDERIV)
   26.              C         whose columns contain the K nonzero basis functions and
   27.              C         their NDERIV-1 right derivatives at X, I=1,K, J=1,NDERIV.
   28.              C         These basis functions have indices ILEFT-K+I, I=1,K,
   29.              C         K .LE. ILEFT .LE. N. The nonzero part of the I-th basis
   30.              C         function lies in (T(I),T(I+K)), I=1,N.
   31.              C
   32.              C         If X=T(ILEFT+1) then VNIKX contains left limiting values
   33.              C         (left derivatives) at T(ILEFT+1).  In particular, ILEFT = N
   34.              C         produces left limiting values at the right end point
   35.              C         X=T(N+1). To obtain left limiting values at T(I), I=K+1,N+1,
   36.              C         set X= next lower distinct knot, call INTRV to get ILEFT,
   37.              C         set X=T(I), and then call BSPVD.
   38.              C
   39.              C         BSPVD calls BSPVN
   40.              C
   41.              C     Description of Arguments
   42.              C         Input
   43.              C          T       - knot vector of length N+K, where
   44.              C                    N = number of B-spline basis functions
   45.              C                    N = sum of knot multiplicities-K
   46.              C          K       - order of the B-spline, K .GE. 1
   47.              C          NDERIV  - number of derivatives = NDERIV-1,
   48.              C                    1 .LE. NDERIV .LE. K
   49.              C          X       - argument of basis functions,
   50.              C                    T(K) .LE. X .LE. T(N+1)
   51.              C          ILEFT   - largest integer such that
   52.              C                    T(ILEFT) .LE. X .LT. T(ILEFT+1)
   53.              C          LDVNIK  - leading dimension of matrix VNIKX
   54.              C
   55.              C         Output
   56.              C          VNIKX   - matrix of dimension at least (K,NDERIV) contain-
   57.              C                    ing the nonzero basis functions at X and their
   58.              C                    derivatives columnwise.
   59.              C          WORK    - a work vector of length (K+1)*(K+2)/2
   60.              C
   61.              C     Error Conditions
   62.              C         Improper input is a fatal error
   63.              C***REFERENCES  C. DE BOOR, *PACKAGE FOR CALCULATING WITH B-SPLINES*,
   64.              C                 SIAM JOURNAL ON NUMERICAL ANALYSIS, VOLUME 14, NO. 3,
   65.              C                 JUNE 1977, PP. 441-472.
   66.              C***ROUTINES CALLED  BSPVN,XERROR
   67.              C***END PROLOGUE  BSPVD
   68.              C
   69.              C
   70.                    INTEGER I,IDERIV,ILEFT,IPKMD,J,JJ,JLOW,JM,JP1MID,K,KMD, KP1, L,
   71.                   1 LDUMMY, M, MHIGH, NDERIV
   72.                    REAL*8 FACTOR, FKMD, V, X
   73.              C     DIMENSION T(ILEFT+K), WORK((K+1)*(K+2)/2)
   74.              C     A(I,J) = WORK(I+J*(J+1)/2),  I=1,J+1  J=1,K-1
   75.              C     A(I,K) = W0RK(I+K*(K-1)/2)  I=1.K
   76.              C     WORK(1) AND WORK((K+1)*(K+2)/2) ARE NOT USED.
   77.                    REAL*8 T(1), VNIKX(LDVNIK,NDERIV), WORK(1)
   78.              C***FIRST EXECUTABLE STATEMENT  BSPVD
   79.                    IF(K.LT.1) GO TO 200
   80.                    IF(NDERIV.LT.1 .OR. NDERIV.GT.K) GO TO 205
   81.                    IF(LDVNIK.LT.K) GO TO 210
   82.                    IDERIV = NDERIV
   83.                    KP1 = K + 1
   84.                    JJ = KP1 - IDERIV
   85.                    CALL BSPVN(T, JJ, K, 1, X, ILEFT, VNIKX, WORK, IWORK)
   86.                    IF (IDERIV.EQ.1) GO TO 100
   87.                    MHIGH = IDERIV
   88.  1---------<       DO 20 M=2,MHIGH
   89.  1                   JP1MID = 1
   90.  1 Vcr4----<         DO 10 J=IDERIV,K
   91.  1 Vcr4                VNIKX(J,IDERIV) = VNIKX(JP1MID,1)
   92.  1 Vcr4                JP1MID = JP1MID + 1
   93.  1 Vcr4---->    10   CONTINUE
   94.  1                   IDERIV = IDERIV - 1
   95.  1                   JJ = KP1 - IDERIV
   96.  1                   CALL BSPVN(T, JJ, K, 2, X, ILEFT, VNIKX, WORK, IWORK)
   97.  1--------->    20 CONTINUE
   98.              C
   99.                    JM = KP1*(KP1+1)/2
  100.  A---------<       DO 30 L = 1,JM
  101.  A                   WORK(L) = 0.0E0
  102.  A--------->    30 CONTINUE
  103.              C     A(I,I) = WORK(I*(I+3)/2) = 1.0       I = 1,K
  104.                    L = 2
  105.                    J = 0
  106.  r4--------<       DO 40 I = 1,K
  107.  r4                  J = J + L
  108.  r4                  WORK(J) = 1.0E0
  109.  r4                  L = L + 1
  110.  r4-------->    40 CONTINUE
  111.                    KMD = K
  112.  1---------<       DO 90 M=2,MHIGH
  113.  1                   KMD = KMD - 1
  114.  1                   FKMD = FLOAT(KMD)
  115.  1                   I = ILEFT
  116.  1                   J = K
  117.  1                   JJ = J*(J+1)/2
  118.  1                   JM = JJ - J
  119.  1 2-------<         DO 60 LDUMMY=1,KMD
  120.  1 2                   IPKMD = I + KMD
  121.  1 2                   FACTOR = FKMD/(T(IPKMD)-T(I))
  122.  1 2 Vcr4--<           DO 50 L=1,J
  123.  1 2 Vcr4                WORK(L+JJ) = (WORK(L+JJ)-WORK(L+JM))*FACTOR
  124.  1 2 Vcr4-->    50     CONTINUE
  125.  1 2                   I = I - 1
  126.  1 2                   J = J - 1
  127.  1 2                   JJ = JM
  128.  1 2                   JM = JM - J
  129.  1 2------->    60   CONTINUE
  130.  1           C
  131.  1 2-------<         DO 80 I=1,K
  132.  1 2                   V = 0.0E0
  133.  1 2                   JLOW = MAX0(I,M)
  134.  1 2                   JJ = JLOW*(JLOW+1)/2
  135.  1 2 r4----<           DO 70 J=JLOW,K
  136.  1 2 r4                  V = WORK(I+JJ)*VNIKX(J,M) + V
  137.  1 2 r4                  JJ = JJ + J + 1
  138.  1 2 r4---->    70     CONTINUE
  139.  1 2                   VNIKX(I,M) = V
  140.  1 2------->    80   CONTINUE
  141.  1--------->    90 CONTINUE
  142.                100 RETURN
  143.              C
  144.              C
  145.                200 CONTINUE
  146.                    CALL XERROR( ' BSPVD,  K DOES NOT SATISFY K.GE.1', 34, 2, 1)
  147.                    RETURN
  148.                205 CONTINUE
  149.                    CALL XERROR( ' BSPVD,  NDERIV DOES NOT SATISFY 1.LE.NDERIV.LE.K',
  150.                   1 49, 2, 1)
  151.                    RETURN
  152.                210 CONTINUE
  153.                    CALL XERROR( ' BSPVD,  LDVNIK DOES NOT SATISFY LDVNIK.GE.K',44,
  154.                   1 2, 1)
  155.                    RETURN
  156.                    END

