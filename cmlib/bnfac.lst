     %%%    L o o p m a r k   L e g e n d    %%%

     Primary Loop Type        Modifiers
     ------- ---- ----        ---------
     A - Pattern matched      a - atomic memory operation
                              b - blocked
     C - Collapsed            c - conditional and/or computed
     D - Deleted               
     E - Cloned               f - fused
     G - Accelerated          g - partitioned
     I - Inlined              i - interchanged
     M - Multithreaded        m - partitioned
                              n - non-blocking remote transfer
                              p - partial
                              r - unrolled
                              s - shortloop
     V - Vectorized           w - unwound


    1.                   SUBROUTINE BNFAC(W,NROWW,NROW,NBANDL,NBANDU,IFLAG)
    2.             C***BEGIN PROLOGUE  BNFAC
    3.             C***REFER TO  BINT4,BINTK
    4.             C
    5.             C  BNFAC is the BANFAC routine from
    6.             C        * A Practical Guide to Splines *  by C. de Boor
    7.             C
    8.             C  Returns in  W  the lu-factorization (without pivoting) of the banded
    9.             C  matrix  A  of order  NROW  with  (NBANDL + 1 + NBANDU) bands or diag-
   10.             C  onals in the work array  W .
   11.             C
   12.             C *****  I N P U T  ******
   13.             C  W.....Work array of size  (NROWW,NROW)  containing the interesting
   14.             C        part of a banded matrix  A , with the diagonals or bands of  A
   15.             C        stored in the rows of  W , while columns of  A  correspond to
   16.             C        columns of  W . This is the storage mode used in  LINPACK  and
   17.             C        results in efficient innermost loops.
   18.             C           Explicitly,  A  has  NBANDL  bands below the diagonal
   19.             C                            +     1     (main) diagonal
   20.             C                            +   NBANDU  bands above the diagonal
   21.             C        and thus, with    MIDDLE = NBANDU + 1,
   22.             C          A(I+J,J)  is in  W(I+MIDDLE,J)  for I=-NBANDU,...,NBANDL
   23.             C                                              J=1,...,NROW .
   24.             C        For example, the interesting entries of A (1,2)-banded matrix
   25.             C        of order  9  would appear in the first  1+1+2 = 4  rows of  W
   26.             C        as follows.
   27.             C                          13 24 35 46 57 68 79
   28.             C                       12 23 34 45 56 67 78 89
   29.             C                    11 22 33 44 55 66 77 88 99
   30.             C                    21 32 43 54 65 76 87 98
   31.             C
   32.             C        All other entries of  W  not identified in this way with an en-
   33.             C        try of  A  are never referenced .
   34.             C  NROWW.....Row dimension of the work array  W .
   35.             C        must be  .GE.  NBANDL + 1 + NBANDU  .
   36.             C  NBANDL.....Number of bands of  A  below the main diagonal
   37.             C  NBANDU.....Number of bands of  A  above the main diagonal .
   38.             C
   39.             C *****  O U T P U T  ******
   40.             C  IFLAG.....Integer indicating success( = 1) or failure ( = 2) .
   41.             C     If  IFLAG = 1, then
   42.             C  W.....contains the LU-factorization of  A  into a unit lower triangu-
   43.             C        lar matrix  L  and an upper triangular matrix  U (both banded)
   44.             C        and stored in customary fashion over the corresponding entries
   45.             C        of  A . This makes it possible to solve any particular linear
   46.             C        system  A*X = B  for  X  by A
   47.             C              CALL BNSLV ( W, NROWW, NROW, NBANDL, NBANDU, B )
   48.             C        with the solution X  contained in  B  on return .
   49.             C     If  IFLAG = 2, then
   50.             C        one of  NROW-1, NBANDL,NBANDU failed to be nonnegative, or else
   51.             C        one of the potential pivots was found to be zero indicating
   52.             C        that  A  does not have an LU-factorization. This implies that
   53.             C        A  is singular in case it is totally positive .
   54.             C
   55.             C *****  M E T H O D  ******
   56.             C     Gauss elimination  W I T H O U T  pivoting is used. The routine is
   57.             C  intended for use with matrices  A  which do not require row inter-
   58.             C  changes during factorization, especially for the  T O T A L L Y
   59.             C  P O S I T I V E  matrices which occur in spline calculations.
   60.             C     The routine should not be used for an arbitrary banded matrix.
   61.             C***ROUTINES CALLED  (NONE)
   62.             C***END PROLOGUE  BNFAC
   63.             C
   64.                   INTEGER IFLAG, NBANDL, NBANDU, NROW, NROWW, I, IPK, J, JMAX, K,
   65.                  1 KMAX, MIDDLE, MIDMK, NROWM1
   66.                   REAL*8 W(NROWW,NROW), FACTOR, PIVOT
   67.             C
   68.             C***FIRST EXECUTABLE STATEMENT  BNFAC
   69.                   IFLAG = 1
   70.                   MIDDLE = NBANDU + 1
   71.             C                         W(MIDDLE,.) CONTAINS THE MAIN DIAGONAL OF  A .
   72.                   NROWM1 = NROW - 1
   73.                   IF (NROWM1) 120, 110, 10
   74.                10 IF (NBANDL.GT.0) GO TO 30
   75.             C                A IS UPPER TRIANGULAR. CHECK THAT DIAGONAL IS NONZERO .
   76.  1--------<       DO 20 I=1,NROWM1
   77.  1                  IF (W(MIDDLE,I).EQ.0.0E0) GO TO 120
   78.  1-------->    20 CONTINUE
   79.                   GO TO 110
   80.                30 IF (NBANDU.GT.0) GO TO 60
   81.             C              A IS LOWER TRIANGULAR. CHECK THAT DIAGONAL IS NONZERO AND
   82.             C                 DIVIDE EACH COLUMN BY ITS DIAGONAL .
   83.  1--------<       DO 50 I=1,NROWM1
   84.  1                  PIVOT = W(MIDDLE,I)
   85.  1                  IF (PIVOT.EQ.0.0E0) GO TO 120
   86.  1                  JMAX = MIN0(NBANDL,NROW-I)
   87.  1 Vr4----<         DO 40 J=1,JMAX
   88.  1 Vr4                W(MIDDLE+J,I) = W(MIDDLE+J,I)/PIVOT
   89.  1 Vr4---->    40   CONTINUE
   90.  1-------->    50 CONTINUE
   91.                   RETURN
   92.             C
   93.             C        A  IS NOT JUST A TRIANGULAR MATRIX. CONSTRUCT LU FACTORIZATION
   94.  1--------<    60 DO 100 I=1,NROWM1
   95.  1          C                                  W(MIDDLE,I)  IS PIVOT FOR I-TH STEP .
   96.  1                  PIVOT = W(MIDDLE,I)
   97.  1                  IF (PIVOT.EQ.0.0E0) GO TO 120
   98.  1          C                 JMAX  IS THE NUMBER OF (NONZERO) ENTRIES IN COLUMN  I
   99.  1          C                     BELOW THE DIAGONAL .
  100.  1                  JMAX = MIN0(NBANDL,NROW-I)
  101.  1          C              DIVIDE EACH ENTRY IN COLUMN  I  BELOW DIAGONAL BY PIVOT .
  102.  1 Vr4----<         DO 70 J=1,JMAX
  103.  1 Vr4                W(MIDDLE+J,I) = W(MIDDLE+J,I)/PIVOT
  104.  1 Vr4---->    70   CONTINUE
  105.  1          C                 KMAX  IS THE NUMBER OF (NONZERO) ENTRIES IN ROW  I  TO
  106.  1          C                     THE RIGHT OF THE DIAGONAL .
  107.  1                  KMAX = MIN0(NBANDU,NROW-I)
  108.  1          C                  SUBTRACT  A(I,I+K)*(I-TH COLUMN) FROM (I+K)-TH COLUMN
  109.  1          C                  (BELOW ROW  I ) .
  110.  1 2------<         DO 90 K=1,KMAX
  111.  1 2                  IPK = I + K
  112.  1 2                  MIDMK = MIDDLE - K
  113.  1 2                  FACTOR = W(MIDMK,IPK)
  114.  1 2 Vr4--<           DO 80 J=1,JMAX
  115.  1 2 Vr4                W(MIDMK+J,IPK) = W(MIDMK+J,IPK) - W(MIDDLE+J,I)*FACTOR
  116.  1 2 Vr4-->    80     CONTINUE
  117.  1 2------>    90   CONTINUE
  118.  1-------->   100 CONTINUE
  119.             C                                       CHECK THE LAST DIAGONAL ENTRY .
  120.               110 IF (W(MIDDLE,NROW).NE.0.0E0) RETURN
  121.               120 IFLAG = 2
  122.                   RETURN
  123.                   END

