    1.              SUBROUTINE BSPVN(T,JHIGH,K,INDEX,X,ILEFT,VNIKX,WORK,IWORK)
    2.        C***BEGIN PROLOGUE  BSPVN
    3.        C***DATE WRITTEN   800901   (YYMMDD)
    4.        C***REVISION DATE  820801   (YYMMDD)
    5.        C***CATEGORY NO.  E3,K6
    6.        C***KEYWORDS  B-SPLINE,DATA FITTING,INTERPOLATION,SPLINE
    7.        C***AUTHOR  AMOS, D. E., (SNLA)
    8.        C***PURPOSE  Calculates the value of all (possibly) nonzero basis
    9.        C            functions at X.
   10.        C***DESCRIPTION
   11.        C
   12.        C     Written by Carl de Boor and modified by D. E. Amos
   13.        C
   14.        C     Reference
   15.        C         SIAM J. Numerical Analysis, 14, No. 3, June, 1977, pp.441-472.
   16.        C
   17.        C     Abstract
   18.        C         BSPVN is the BSPLVN routine of the reference.
   19.        C
   20.        C         BSPVN calculates the value of all (possibly) nonzero basis
   21.        C         functions at X of order MAX(JHIGH,(J+1)*(INDEX-1)), where
   22.        C         T(K) .LE. X .LE. T(N+1) and J=IWORK is set inside the routine
   23.        C         on the first call when INDEX=1.  ILEFT is such that T(ILEFT)
   24.        C         .LE. X .LT. T(ILEFT+1).  A call to INTRV(T,N+1,X,ILO,ILEFT,
   25.        C         MFLAG) produces the proper ILEFT.  BSPVN calculates using the
   26.        C         basic algorithm needed in BSPVD.  If only basis functions are
   27.        C         desired, setting JHIGH=K and INDEX=1 can be faster than
   28.        C         calling BSPVD, but extra coding is required for derivatives
   29.        C         (INDEX=2) and BSPVD is set up for this purpose.
   30.        C
   31.        C         Left limiting values are set up as described in BSPVD.
   32.        C
   33.        C     Description of Arguments
   34.        C         Input
   35.        C          T       - knot vector of length N+K, where
   36.        C                    N = number of B-spline basis functions
   37.        C                    N = sum of knot multiplicities-K
   38.        C          JHIGH   - order of B-spline, 1 .LE. JHIGH .LE. K
   39.        C          K       - highest possible order
   40.        C          INDEX   - INDEX = 1 gives basis functions of order JHIGH
   41.        C                          = 2 denotes previous entry with WORK, IWORK
   42.        C                              values saved for subsequent calls to
   43.        C                              BSPVN.
   44.        C          X       - argument of basis functions,
   45.        C                    T(K) .LE. X .LE. T(N+1)
   46.        C          ILEFT   - largest integer such that
   47.        C                    T(ILEFT) .LE. X .LT. T(ILEFT+1)
   48.        C
   49.        C         Output
   50.        C          VNIKX   - vector of length K for spline values.
   51.        C          WORK    - a work vector of length 2*K
   52.        C          IWORK   - a work parameter.  Both WORK and IWORK contain
   53.        C                    information necessary to continue for INDEX = 2.
   54.        C                    When INDEX = 1 exclusively, these are scratch
   55.        C                    variables and can be used for other purposes.
   56.        C
   57.        C     Error Conditions
   58.        C         Improper input is a fatal error.
   59.        C***REFERENCES  C. DE BOOR, *PACKAGE FOR CALCULATING WITH B-SPLINES*,
   60.        C                 SIAM JOURNAL ON NUMERICAL ANALYSIS, VOLUME 14, NO. 3,
   61.        C                 JUNE 1977, PP. 441-472.
   62.        C***ROUTINES CALLED  XERROR
   63.        C***END PROLOGUE  BSPVN
   64.        C
   65.        C
   66.              INTEGER ILEFT, IMJP1, INDEX, IPJ, IWORK, JHIGH, JP1, JP1ML, K, L
   67.              REAL*8 VM, VMPREV, X
   68.        C     DIMENSION T(ILEFT+JHIGH)
   69.              REAL*8 T(1), VNIKX(K), WORK(1)
   70.        C     CONTENT OF J, DELTAM, DELTAP IS EXPECTED UNCHANGED BETWEEN CALLS.
   71.        C     WORK(I) = DELTAP(I), WORK(K+I) = DELTAM(I), I = 1,K
   72.        C***FIRST EXECUTABLE STATEMENT  BSPVN
   73.              IF(K.LT.1) GO TO 90
   74.              IF(JHIGH.GT.K .OR. JHIGH.LT.1) GO TO 100
   75.              IF(INDEX.LT.1 .OR. INDEX.GT.2) GO TO 105
   76.              IF(X.LT.T(ILEFT) .OR. X.GT.T(ILEFT+1)) GO TO 110
   77.              GO TO (10, 20), INDEX
   78.           10 IWORK = 1
   79.              VNIKX(1) = 1.0E0
   80.              IF (IWORK.GE.JHIGH) GO TO 40
   81.        C
   82.           20 IPJ = ILEFT + IWORK
   83.              WORK(IWORK) = T(IPJ) - X
   84.              IMJP1 = ILEFT - IWORK + 1
   85.              WORK(K+IWORK) = X - T(IMJP1)
   86.              VMPREV = 0.0E0
   87.              JP1 = IWORK + 1
   88.  r4--<       DO 30 L=1,IWORK
   89.  r4            JP1ML = JP1 - L
   90.  r4            VM = VNIKX(L)/(WORK(L)+WORK(K+JP1ML))
   91.  r4            VNIKX(L) = VM*WORK(L) + VMPREV
   92.  r4            VMPREV = VM*WORK(K+JP1ML)
   93.  r4-->    30 CONTINUE
   94.              VNIKX(JP1) = VMPREV
   95.              IWORK = JP1
   96.              IF (IWORK.LT.JHIGH) GO TO 20
   97.        C
   98.           40 RETURN
   99.        C
  100.        C
  101.           90 CONTINUE
  102.              CALL XERROR( ' BSPVN,  K DOES NOT SATISFY K.GE.1', 34, 2, 1)
  103.              RETURN
  104.          100 CONTINUE
  105.              CALL XERROR( ' BSPVN,  JHIGH DOES NOT SATISFY 1.LE.JHIGH.LE.K',
  106.             1 47, 2, 1)
  107.              RETURN
  108.          105 CONTINUE
  109.              CALL XERROR( ' BSPVN,  INDEX IS NOT 1 OR 2',28,2,1)
  110.              RETURN
  111.          110 CONTINUE
  112.              CALL XERROR( ' BSPVN,  X DOES NOT SATISFY T(ILEFT).LE.X.LE.T(ILEFT
  113.             1+1)', 55, 2, 1)
  114.              RETURN
  115.              END

