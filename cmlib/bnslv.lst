     %%%    L o o p m a r k   L e g e n d    %%%

     Primary Loop Type        Modifiers
     ------- ---- ----        ---------
     A - Pattern matched      a - atomic memory operation
                              b - blocked
     C - Collapsed            c - conditional and/or computed
     D - Deleted               
     E - Cloned               f - fused
     G - Accelerated          g - partitioned
     I - Inlined              i - interchanged
     M - Multithreaded        m - partitioned
                              n - non-blocking remote transfer
                              p - partial
                              r - unrolled
                              s - shortloop
     V - Vectorized           w - unwound


    1.                 SUBROUTINE BNSLV(W,NROWW,NROW,NBANDL,NBANDU,B)
    2.           C***BEGIN PROLOGUE  BNSLV
    3.           C***REFER TO  BINT4,BINTK
    4.           C
    5.           C  BNSLV is the BANSLV routine from
    6.           C        * A Practical Guide to Splines *  by C. de Boor
    7.           C
    8.           C  Companion routine to  BNFAC . It returns the solution  X  of the
    9.           C  linear system  A*X = B  in place of  B , given the LU-factorization
   10.           C  for  A  in the work array  W from BNFAC.
   11.           C
   12.           C *****  I N P U T  ******
   13.           C  W, NROWW,NROW,NBANDL,NBANDU.....describe the LU-factorization of a
   14.           C        banded matrix  A  of order  NROW  as constructed in  BNFAC .
   15.           C        For details, see  BNFAC .
   16.           C  B.....Right side of the system to be solved .
   17.           C
   18.           C *****  O U T P U T  ******
   19.           C  B.....Contains the solution  X , of order  NROW .
   20.           C
   21.           C *****  M E T H O D  ******
   22.           C     (With  A = L*U, as stored in  W,) the unit lower triangular system
   23.           C  L(U*X) = B  is solved for  Y = U*X, and  Y  stored in  B . Then the
   24.           C  upper triangular system  U*X = Y  is solved for  X  . The calcul-
   25.           C  ations are so arranged that the innermost loops stay within columns.
   26.           C***ROUTINES CALLED  (NONE)
   27.           C***END PROLOGUE  BNSLV
   28.           C
   29.                 INTEGER NBANDL, NBANDU, NROW, NROWW, I, J, JMAX, MIDDLE, NROWM1
   30.                 REAL*8 W(NROWW,NROW), B(NROW)
   31.           C***FIRST EXECUTABLE STATEMENT  BNSLV
   32.                 MIDDLE = NBANDU + 1
   33.                 IF (NROW.EQ.1) GO TO 80
   34.                 NROWM1 = NROW - 1
   35.                 IF (NBANDL.EQ.0) GO TO 30
   36.           C                                 FORWARD PASS
   37.           C            FOR I=1,2,...,NROW-1, SUBTRACT  RIGHT SIDE(I)*(I-TH COLUMN
   38.           C            OF  L )  FROM RIGHT SIDE  (BELOW I-TH ROW) .
   39.  1------<       DO 20 I=1,NROWM1
   40.  1                JMAX = MIN0(NBANDL,NROW-I)
   41.  1 Vr4--<         DO 10 J=1,JMAX
   42.  1 Vr4              B(I+J) = B(I+J) - B(I)*W(MIDDLE+J,I)
   43.  1 Vr4-->    10   CONTINUE
   44.  1------>    20 CONTINUE
   45.           C                                 BACKWARD PASS
   46.           C            FOR I=NROW,NROW-1,...,1, DIVIDE RIGHT SIDE(I) BY I-TH DIAG-
   47.           C            ONAL ENTRY OF  U, THEN SUBTRACT  RIGHT SIDE(I)*(I-TH COLUMN
   48.           C            OF  U)  FROM RIGHT SIDE  (ABOVE I-TH ROW).
   49.              30 IF (NBANDU.GT.0) GO TO 50
   50.           C                                A  IS LOWER TRIANGULAR .
   51.  Vpr4---<       DO 40 I=1,NROW
   52.  Vpr4             B(I) = B(I)/W(1,I)
   53.  Vpr4--->    40 CONTINUE
   54.                 RETURN
   55.              50 I = NROW
   56.              60 B(I) = B(I)/W(MIDDLE,I)
   57.                 JMAX = MIN0(NBANDU,I-1)
   58.  Vr4----<       DO 70 J=1,JMAX
   59.  Vr4              B(I-J) = B(I-J) - B(I)*W(MIDDLE-J,I)
   60.  Vr4---->    70 CONTINUE
   61.                 I = I - 1
   62.                 IF (I.GT.1) GO TO 60
   63.              80 B(1) = B(1)/W(MIDDLE,1)
   64.                 RETURN
   65.                 END

