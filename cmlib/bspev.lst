     %%%    L o o p m a r k   L e g e n d    %%%

     Primary Loop Type        Modifiers
     ------- ---- ----        ---------
     A - Pattern matched      a - atomic memory operation
                              b - blocked
     C - Collapsed            c - conditional and/or computed
     D - Deleted               
     E - Cloned               f - fused
     G - Accelerated          g - partitioned
     I - Inlined              i - interchanged
     M - Multithreaded        m - partitioned
                              n - non-blocking remote transfer
                              p - partial
                              r - unrolled
                              s - shortloop
     V - Vectorized           w - unwound


    1.               SUBROUTINE BSPEV(T,AD,N,K,NDERIV,X,INEV,SVALUE,WORK)
    2.         C***BEGIN PROLOGUE  BSPEV
    3.         C***DATE WRITTEN   800901   (YYMMDD)
    4.         C***REVISION DATE  820801   (YYMMDD)
    5.         C***CATEGORY NO.  E3,K6
    6.         C***KEYWORDS  B-SPLINE,DATA FITTING,INTERPOLATION,SPLINE
    7.         C***AUTHOR  AMOS, D. E., (SNLA)
    8.         C***PURPOSE  Calculates the value of the spline and its derivatives at X
    9.         C            from the B-representation .
   10.         C***DESCRIPTION
   11.         C
   12.         C     Written by Carl de Boor and modified by D. E. Amos
   13.         C
   14.         C     Reference
   15.         C         SIAM J. Numerical Analysis, 14, No. 3, June, 1977, pp.441-472.
   16.         C
   17.         C     Abstract
   18.         C         BSPEV is the BSPLEV routine of the reference.
   19.         C
   20.         C         BSPEV calculates the value of the spline and its derivatives
   21.         C         at X from the B-representation (T,A,N,K) and returns them
   22.         C         in SVALUE(I),I=1,NDERIV, T(K) .LE. X .LE. T(N+1).  AD(I) can
   23.         C         be the B-spline coefficients A(I), I=1,N if NDERIV=1.  Other-
   24.         C         wise AD must be computed before hand by a call to BSPDR (T,A,
   25.         C         N,K,NDERIV,AD).  If X=T(I),I=K,N, right limiting values are
   26.         C         obtained.
   27.         C
   28.         C         To compute left derivatives or left limiting values at a
   29.         C         knot T(I), replace N by I-1 and set X=T(I), I=K+1,N+1.
   30.         C
   31.         C         BSPEV calls INTRV, BSPVN
   32.         C
   33.         C     Description of Arguments
   34.         C         Input
   35.         C          T       - knot vector of length N+K
   36.         C          AD      - vector of length (2*N-NDERIV+1)*NDERIV/2 containing
   37.         C                    the difference table from BSPDR.
   38.         C          N       - number of B-spline coefficients
   39.         C                    N = sum of knot multiplicities-K
   40.         C          K       - order of the B-spline, K .GE. 1
   41.         C          NDERIV  - number of derivatives, 1 .LE. NDERIV .LE. K.
   42.         C                    NDERIV=1 gives the zero-th derivative = function
   43.         C                    value
   44.         C          X       - argument, T(K) .LE. X .LE. T(N+1)
   45.         C          INEV    - an initialization parameter which must be set
   46.         C                    to 1 the first time BSPEV is called.
   47.         C
   48.         C         Output
   49.         C          INEV    - INEV contains information for efficient process-
   50.         C                    ing after the initial call and INEV must not
   51.         C                    be changed by the user.  Distinct splines require
   52.         C                    distinct INEV parameters.
   53.         C          SVALUE  - vector of length NDERIV containing the spline
   54.         C                    value in SVALUE(1) and the NDERIV-1 derivatives
   55.         C                    in the remaining components.
   56.         C          WORK    - work vector of length 3*K
   57.         C
   58.         C     Error Conditions
   59.         C         Improper input is a fatal error.
   60.         C***REFERENCES  C. DE BOOR, *PACKAGE FOR CALCULATING WITH B-SPLINES*,
   61.         C                 SIAM JOURNAL ON NUMERICAL ANALYSIS, VOLUME 14, NO. 3,
   62.         C                 JUNE 1977, PP. 441-472.
   63.         C***ROUTINES CALLED  BSPVN,INTRV,XERROR
   64.         C***END PROLOGUE  BSPEV
   65.         C
   66.         C
   67.               INTEGER I,ID,INEV,IWORK,JJ,K,KP1,KP1MN,L,LEFT,LL,MFLAG,
   68.              1 N, NDERIV
   69.               REAL*8 SUM, X
   70.         C     DIMENSION T(N+K)
   71.               REAL*8 T(1), AD(1), SVALUE(NDERIV), WORK(1)
   72.         C***FIRST EXECUTABLE STATEMENT  BSPEV
   73.               IF(K.LT.1) GO TO 100
   74.               IF(N.LT.K) GO TO 105
   75.               IF(NDERIV.LT.1 .OR. NDERIV.GT.K) GO TO 115
   76.               ID = NDERIV
   77.               CALL INTRV(T, N+1, X, INEV, I, MFLAG)
   78.               IF (X.LT.T(K)) GO TO 110
   79.               IF (MFLAG.EQ.0) GO TO 30
   80.               IF (X.GT.T(I)) GO TO 110
   81.            20 IF (I.EQ.K) GO TO 120
   82.               I = I - 1
   83.               IF (X.EQ.T(I)) GO TO 20
   84.         C
   85.         C *I* HAS BEEN FOUND IN (K,N) SO THAT T(I) .LE. X .LT. T(I+1)
   86.         C     (OR .LE. T(I+1), IF T(I) .LT. T(I+1) = T(N+1) ).
   87.            30 KP1MN = K + 1 - ID
   88.               KP1 = K + 1
   89.               CALL BSPVN(T, KP1MN, K, 1, X, I, WORK(1),WORK(KP1),IWORK)
   90.               JJ = (N+N-ID+2)*(ID-1)/2
   91.         C     ADIF(LEFTPL,ID) = AD(LEFTPL-ID+1 + (2*N-ID+2)*(ID-1)/2)
   92.         C     LEFTPL = LEFT + L
   93.            40 LEFT = I - KP1MN
   94.               SUM = 0.0E0
   95.               LL = LEFT + JJ + 2 - ID
   96.  Vr6--<       DO 50 L=1,KP1MN
   97.  Vr6            SUM = SUM + WORK(L)*AD(LL)
   98.  Vr6            LL = LL + 1
   99.  Vr6-->    50 CONTINUE
  100.               SVALUE(ID) = SUM
  101.               ID = ID - 1
  102.               IF (ID.EQ.0) GO TO 60
  103.               JJ = JJ-(N-ID+1)
  104.               KP1MN = KP1MN + 1
  105.               CALL BSPVN(T, KP1MN, K, 2, X, I, WORK(1), WORK(KP1),IWORK)
  106.               GO TO 40
  107.         C
  108.            60 RETURN
  109.         C
  110.         C
  111.           100 CONTINUE
  112.               CALL XERROR( ' BSPEV,  K DOES NOT SATISFY K.GE.1',34,2,1)
  113.               RETURN
  114.           105 CONTINUE
  115.               CALL XERROR( ' BSPEV,  N DOES NOT SATISFY N.GE.K',34,2,1)
  116.               RETURN
  117.           110 CONTINUE
  118.               CALL XERROR( ' BSPEV,  X IS NOT IN T(K).LE.X.LE.T(N+1)',40,2,1)
  119.               RETURN
  120.           115 CONTINUE
  121.               CALL XERROR( ' BSPEV,  NDERIV DOES NOT SATISFY 1.LE.NDERIV.LE.K',
  122.              1 49, 2, 1)
  123.               RETURN
  124.           120 CONTINUE
  125.               CALL XERROR( ' BSPEV,  A LEFT LIMITING VALUE CANNOT BE OBTAINED AT
  126.              1 T(K)',57,2,1)
  127.               RETURN
  128.               END

