     %%%    L o o p m a r k   L e g e n d    %%%

     Primary Loop Type        Modifiers
     ------- ---- ----        ---------
     A - Pattern matched      a - atomic memory operation
                              b - blocked
     C - Collapsed            c - conditional and/or computed
     D - Deleted               
     E - Cloned               f - fused
     G - Accelerated          g - partitioned
     I - Inlined              i - interchanged
     M - Multithreaded        m - partitioned
                              n - non-blocking remote transfer
                              p - partial
                              r - unrolled
                              s - shortloop
     V - Vectorized           w - unwound


    1.            SUBROUTINE PPGQ8(FUN,LDC,C,XI,LXI,KK,ID,A,B,INPPV,ERR,ANS,IERR)
    2.      C***BEGIN PROLOGUE  PPGQ8
    3.      C***REFER TO  PFQAD
    4.      C
    5.      C     Written by R.E. Jones and modified by D.E. Amos
    6.      C
    7.      C     Abstract
    8.      C        PPGQ8, a modification of GAUS8, integrates the
    9.      C        product of FUN(X) by the ID-th derivative of a spline
   10.      C        PPVAL(LDC,C,XI,LXI,KK,ID,X,INPPV)  between limits A and B.
   11.      C
   12.      C        PPGQ8 calls PPVAL, INTRV, I1MACH, R1MACH, XERROR
   13.      C
   14.      C     Description of arguments
   15.      C
   16.      C        INPUT--
   17.      C        FUN - Name of external function of one argument which
   18.      C              multiplies PPVAL.
   19.      C        LDC - Leading dimension of matrix C, LDC.GE.KK
   20.      C        C   - Matrix of Tayor derivatives of dimension at least
   21.      C              (K,LXI)
   22.      C        XI  - Breakpoint vector of length LXI+1
   23.      C        LXI - Number of polynomial pieces
   24.      C        KK  - Order of the spline, KK.GE.1
   25.      C        ID  - Order of the spline derivative, 0.LE.ID.LE.KK-1
   26.      C        A   - Lower limit of integral
   27.      C        B   - Upper limit of integral (may be less than A)
   28.      C        INPPV- Initialization parameter for PPVAL
   29.      C        ERR - Is a requested pseudorelative error tolerance.  Normally
   30.      C              pick a value of ABS(ERR).LT.1E-3.  ANS will normally
   31.      C              have no more error than ABS(ERR) times the integral of
   32.      C              the absolute value of FUN(X)*PPVAL(LDC,C,XI,LXI,KK,ID,X,
   33.      C              INPPV).
   34.      C
   35.      C        OUTPUT--
   36.      C        ERR - Will be an estimate of the absolute error in ANS if the
   37.      C              input value of ERR was negative.  (ERR is unchanged if
   38.      C              the input value of ERR was nonnegative.)  The estimated
   39.      C              error is solely for information to the user and should
   40.      C              not be used as a correction to the computed integral.
   41.      C        ANS - Computed value of integral
   42.      C        IERR- A status code
   43.      C            --Normal codes
   44.      C               1 ANS most likely meets requested error tolerance,
   45.      C                 or A=B.
   46.      C              -1 A and B ARE too nearly equal to allow normal
   47.      C                 integration.  ANS is set to zero.
   48.      C            --Abnormal code
   49.      C               2 ANS probably does not meet requested error tolerance.
   50.      C***ROUTINES CALLED  I1MACH,PPVAL,R1MACH,XERROR
   51.      C***END PROLOGUE  PPGQ8
   52.      C
   53.            INTEGER ICALL,ID,IERR,INPPV,K,KK,KML,KMX,L,LDC,LMN,LMX,LR(30),
   54.           1 LXI,MXL,NBITS, NIB, NLMN, NLMX
   55.            INTEGER I1MACH
   56.            REAL*8 A,AE,ANIB, ANS,AREA,B,  BE,CC,EE, EF, EPS, ERR,
   57.           1 EST,GL,GLR,SQ2,TOL,VR,W1, W2, W3, W4, X1,
   58.           2 X2, X3, X4, X, H
   59.            REAL*8 R1MACH, PPVAL, G8, FUN
   60.            REAL*8 XI(1), C(LDC,1)
   61.            REAL*8 AA(30), HH(30), VL(30), GR(30)
   62.            DATA X1, X2, X3, X4/
   63.           1     1.83434642495649805E-01,     5.25532409916328986E-01,
   64.           2     7.96666477413626740E-01,     9.60289856497536232E-01/
   65.            DATA W1, W2, W3, W4/
   66.           1     3.62683783378361983E-01,     3.13706645877887287E-01,
   67.           2     2.22381034453374471E-01,     1.01228536290376259E-01/
   68.            DATA ICALL  /  0  /
   69.            DATA SQ2/1.41421356E0/
   70.            DATA NLMN/1/,KMX/5000/,KML/6/
   71.            G8(X,H)=H*((W1*(FUN(X-X1*H)*PPVAL(LDC,C,XI,LXI,KK,ID,X-X1*H,INPPV)
   72.           1             +FUN(X+X1*H)*PPVAL(LDC,C,XI,LXI,KK,ID,X+X1*H,INPPV))
   73.           2          +W2*(FUN(X-X2*H)*PPVAL(LDC,C,XI,LXI,KK,ID,X-X2*H,INPPV)
   74.           3            +FUN(X+X2*H)*PPVAL(LDC,C,XI,LXI,KK,ID,X+X2*H,INPPV)))
   75.           4        +(W3*(FUN(X-X3*H)*PPVAL(LDC,C,XI,LXI,KK,ID,X-X3*H,INPPV)
   76.           5             +FUN(X+X3*H)*PPVAL(LDC,C,XI,LXI,KK,ID,X+X3*H,INPPV))
   77.           6         +W4*(FUN(X-X4*H)*PPVAL(LDC,C,XI,LXI,KK,ID,X-X4*H,INPPV)
   78.           7          +FUN(X+X4*H)*PPVAL(LDC,C,XI,LXI,KK,ID,X+X4*H,INPPV))))
   79.      C
   80.      C     INITIALIZE
   81.      C
   82.      C***FIRST EXECUTABLE STATEMENT  PPGQ8
   83.            IF (ICALL.NE.0) CALL XERROR( 'PPGQ8- PPGQ8 CALLED RECURSIVELY.  RE
   84.           1CURSIVE CALLS ARE ILLEGAL IN FORTRAN.', 73, 7, 2)
   85.            ICALL = 1
   86.  I         K = I1MACH(11)
   87.            ANIB = R1MACH(5)*FLOAT(K)/0.30102000E0
   88.            NBITS = INT(ANIB)
   89.            NLMX = (NBITS*5)/8
   90.            ANS = 0.0E0
   91.            IERR = 1
   92.            BE = 0.0E0
   93.            IF (A.EQ.B) GO TO 140
   94.            LMX = NLMX
   95.            LMN = NLMN
   96.            IF (B.EQ.0.0E0) GO TO 10
   97.            IF (SIGN(1.0D0,B)*A.LE.0.0D0) GO TO 10
   98.            CC = ABS(1.0E0-A/B)
   99.            IF (CC.GT.0.1E0) GO TO 10
  100.            IF (CC.LE.0.0E0) GO TO 140
  101.            ANIB = 0.5E0 - LOG(CC)/0.69314718E0
  102.            NIB = INT(ANIB)
  103.            LMX = MIN0(NLMX,NBITS-NIB-7)
  104.            IF (LMX.LT.1) GO TO 130
  105.            LMN = MIN0(LMN,LMX)
  106.         10 TOL = MAX(ABS(ERR),2.0D0**(5-NBITS))/2.0D0
  107.            IF (ERR.EQ.0.0E0) TOL = SQRT(R1MACH(4))
  108.            EPS = TOL
  109.            HH(1) = (B-A)/4.0E0
  110.            AA(1) = A
  111.            LR(1) = 1
  112.            L = 1
  113.            EST = G8(AA(L)+2.0E0*HH(L),2.0E0*HH(L))
  114.            K = 8
  115.            AREA = ABS(EST)
  116.            EF = 0.5E0
  117.            MXL = 0
  118.      C
  119.      C     COMPUTE REFINED ESTIMATES, ESTIMATE THE ERROR, ETC.
  120.      C
  121.         20 GL = G8(AA(L)+HH(L),HH(L))
  122.            GR(L) = G8(AA(L)+3.0E0*HH(L),HH(L))
  123.            K = K + 16
  124.            AREA = AREA + (ABS(GL)+ABS(GR(L))-ABS(EST))
  125.            GLR = GL + GR(L)
  126.            EE = ABS(EST-GLR)*EF
  127.            AE = MAX(EPS*AREA,TOL*ABS(GLR))
  128.            IF (EE-AE) 40, 40, 50
  129.         30 MXL = 1
  130.         40 BE = BE + (EST-GLR)
  131.            IF (LR(L)) 60, 60, 80
  132.      C
  133.      C     CONSIDER THE LEFT HALF OF THIS LEVEL
  134.      C
  135.         50 IF (K.GT.KMX) LMX = KML
  136.            IF (L.GE.LMX) GO TO 30
  137.            L = L + 1
  138.            EPS = EPS*0.5E0
  139.            EF = EF/SQ2
  140.            HH(L) = HH(L-1)*0.5E0
  141.            LR(L) = -1
  142.            AA(L) = AA(L-1)
  143.            EST = GL
  144.            GO TO 20
  145.      C
  146.      C     PROCEED TO RIGHT HALF AT THIS LEVEL
  147.      C
  148.         60 VL(L) = GLR
  149.         70 EST = GR(L-1)
  150.            LR(L) = 1
  151.            AA(L) = AA(L) + 4.0E0*HH(L)
  152.            GO TO 20
  153.      C
  154.      C     RETURN ONE LEVEL
  155.      C
  156.         80 VR = GLR
  157.         90 IF (L.LE.1) GO TO 120
  158.            L = L - 1
  159.            EPS = EPS*2.0E0
  160.            EF = EF*SQ2
  161.            IF (LR(L)) 100, 100, 110
  162.        100 VL(L) = VL(L+1) + VR
  163.            GO TO 70
  164.        110 VR = VL(L+1) + VR
  165.            GO TO 90
  166.      C
  167.      C      EXIT
  168.      C
  169.        120 ANS = VR
  170.            IF ((MXL.EQ.0) .OR. (ABS(BE).LE.2.0E0*TOL*AREA)) GO TO 140
  171.            IERR = 2
  172.            CALL XERROR( 'PPGQ8- ANS IS PROBABLY INSUFFICIENTLY ACCURATE.',
  173.           1 47, 3, 1)
  174.            GO TO 140
  175.        130 IERR = -1
  176.            CALL XERROR( 'PPGQ8- THE FOLLOWING TEMPORARY DIAGNOSTIC WILL APPEA
  177.           1R ONLY ONCE.  A AND B ARE TOO NEARLY EQUAL TO ALLOW NORMAL INTEGRA
  178.           2TION.  ANS IS SET TO ZERO, AND IERR=-1.', 157, 1, -1)
  179.        140 ICALL = 0
  180.            IF (ERR.LT.0.0E0) ERR = BE
  181.            RETURN
  182.            END

