     %%%    L o o p m a r k   L e g e n d    %%%

     Primary Loop Type        Modifiers
     ------- ---- ----        ---------
     A - Pattern matched      a - atomic memory operation
                              b - blocked
     C - Collapsed            c - conditional and/or computed
     D - Deleted               
     E - Cloned               f - fused
     G - Accelerated          g - partitioned
     I - Inlined              i - interchanged
     M - Multithreaded        m - partitioned
                              n - non-blocking remote transfer
                              p - partial
                              r - unrolled
                              s - shortloop
     V - Vectorized           w - unwound


    1.                SUBROUTINE BSPDR(T,A,N,K,NDERIV,AD)
    2.          C***BEGIN PROLOGUE  BSPDR
    3.          C***DATE WRITTEN   800901   (YYMMDD)
    4.          C***REVISION DATE  820801   (YYMMDD)
    5.          C***CATEGORY NO.  E3
    6.          C***KEYWORDS  B-SPLINE,DATA FITTING,INTERPOLATION,SPLINE
    7.          C***AUTHOR  AMOS, D. E., (SNLA)
    8.          C***PURPOSE  Uses the B-representation to construct a divided difference
    9.          C            table preparatory to a (right) derivative calculation in
   10.          C            BSPEV.
   11.          C***DESCRIPTION
   12.          C
   13.          C     Written by Carl de Boor and modified by D. E. Amos
   14.          C
   15.          C     Reference
   16.          C         SIAM J. Numerical Analysis, 14, No. 3, June, 1977, pp.441-472.
   17.          C
   18.          C     Abstract
   19.          C         BSPDR is the BSPLDR routine of the reference.
   20.          C
   21.          C         BSPDR uses the B-representation (T,A,N,K) to construct a
   22.          C         divided difference table ADIF preparatory to a (right)
   23.          C         derivative calculation in BSPEV.  The lower triangular matrix
   24.          C         ADIF is stored in vector AD by columns.  The arrays are
   25.          C         related by
   26.          C
   27.          C           ADIF(I,J) = AD(I-J+1 + (2*N-J+2)*(J-1)/2)
   28.          C
   29.          C         I = J,N , J = 1,NDERIV .
   30.          C
   31.          C     Description of Arguments
   32.          C         Input
   33.          C          T       - knot vector of length N+K
   34.          C          A       - B-spline coefficient vector of length N
   35.          C          N       - number of B-spline coefficients
   36.          C                    N = sum of knot multiplicities-K
   37.          C          K       - order of the spline, K .GE. 1
   38.          C          NDERIV  - number of derivatives, 1 .LE. NDERIV .LE. K.
   39.          C                    NDERIV=1 gives the zero-th derivative = function
   40.          C                    value
   41.          C
   42.          C         Output
   43.          C          AD      - table of differences in a vector of length
   44.          C                    (2*N-NDERIV+1)*NDERIV/2 for input to BSPEV
   45.          C
   46.          C     Error Conditions
   47.          C         Improper input is a fatal error
   48.          C***REFERENCES  C. DE BOOR, *PACKAGE FOR CALCULATING WITH B-SPLINES*,
   49.          C                 SIAM JOURNAL ON NUMERICAL ANALYSIS, VOLUME 14, NO. 3,
   50.          C                 JUNE 1977, PP. 441-472.
   51.          C***ROUTINES CALLED  XERROR
   52.          C***END PROLOGUE  BSPDR
   53.          C
   54.          C
   55.                INTEGER I, ID, II, IPKMID, JJ, JM, K, KMID, N, NDERIV
   56.                REAL*8 DIFF, FKMID
   57.          C     DIMENSION T(N+K), AD((2*N-NDERIV+1)*NDERIV/2)
   58.                REAL*8 T(1), A(N), AD(1)
   59.          C***FIRST EXECUTABLE STATEMENT  BSPDR
   60.                IF(K.LT.1) GO TO 100
   61.                IF(N.LT.K) GO TO 105
   62.                IF(NDERIV.LT.1 .OR. NDERIV.GT.K) GO TO 110
   63.  A-----<       DO 10 I=1,N
   64.  A               AD(I) = A(I)
   65.  A----->    10 CONTINUE
   66.                IF (NDERIV.EQ.1) RETURN
   67.                KMID = K
   68.                JJ = N
   69.                JM = 0
   70.  1-----<       DO 30 ID=2,NDERIV
   71.  1               KMID = KMID - 1
   72.  1               FKMID = FLOAT(KMID)
   73.  1               II = 1
   74.  1 Vc--<         DO 20 I=ID,N
   75.  1 Vc              IPKMID = I + KMID
   76.  1 Vc              DIFF = T(IPKMID) - T(I)
   77.  1 Vc              IF (DIFF.NE.0.0E0) AD(II+JJ) = (AD(II+JM+1)-AD(II+JM))/
   78.  1 Vc         1     DIFF*FKMID
   79.  1 Vc              II = II + 1
   80.  1 Vc-->    20   CONTINUE
   81.  1               JM = JJ
   82.  1               JJ = JJ + N - ID + 1
   83.  1----->    30 CONTINUE
   84.                RETURN
   85.          C
   86.          C
   87.            100 CONTINUE
   88.                CALL XERROR( ' BSPDR,  K DOES NOT SATISFY K.GE.1', 34, 2, 1)
   89.                RETURN
   90.            105 CONTINUE
   91.                CALL XERROR( ' BSPDR,  N DOES NOT SATISFY N.GE.K', 34, 2, 1)
   92.                RETURN
   93.            110 CONTINUE
   94.                CALL XERROR( ' BSPDR,  NDERIV DOES NOT SATISFY 1.LE.NDERIV.LE.K',
   95.               1 49, 2, 1)
   96.                RETURN
   97.                END

