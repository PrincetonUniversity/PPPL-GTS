    1.          SUBROUTINE INTRV(XT,LXT,X,ILO,ILEFT,MFLAG)
    2.    C***BEGIN PROLOGUE  INTRV
    3.    C***DATE WRITTEN   800901   (YYMMDD)
    4.    C***REVISION DATE  820801   (YYMMDD)
    5.    C***CATEGORY NO.  E3,K6
    6.    C***KEYWORDS  B-SPLINE,DATA FITTING,INTERPOLATION,SPLINE
    7.    C***AUTHOR  AMOS, D. E., (SNLA)
    8.    C***PURPOSE  Computes the largest integer ILEFT in 1.LE.ILEFT.LE.LXT
    9.    C            such that XT(ILEFT).LE.X where XT(*) is a subdivision
   10.    C            of the X interval.
   11.    C***DESCRIPTION
   12.    C
   13.    C     Written by Carl de Boor and modified by D. E. Amos
   14.    C
   15.    C     Reference
   16.    C         SIAM J. Numerical Analysis, 14, No. 3, June 1977, pp. 441-472.
   17.    C
   18.    C     Abstract
   19.    C         INTRV is the INTERV routine of the reference.
   20.    C
   21.    C         INTRV computes the largest integer ILEFT in 1 .LE. ILEFT .LE.
   22.    C         LXT such that XT(ILEFT) .LE. X where XT(*) is a subdivision of
   23.    C         the X interval.  Precisely,
   24.    C
   25.    C                      X .LT. XT(1)                1         -1
   26.    C         if  XT(I) .LE. X .LT. XT(I+1)  then  ILEFT=I  , MFLAG=0
   27.    C           XT(LXT) .LE. X                         LXT        1,
   28.    C
   29.    C         That is, when multiplicities are present in the break point
   30.    C         to the left of X, the largest index is taken for ILEFT.
   31.    C
   32.    C     Description of Arguments
   33.    C         Input
   34.    C          XT      - XT is a knot or break point vector of length LXT
   35.    C          LXT     - length of the XT vector
   36.    C          X       - argument
   37.    C          ILO     - an initialization parameter which must be set
   38.    C                    to 1 the first time the spline array XT is
   39.    C                    processed by INTRV.
   40.    C
   41.    C         Output
   42.    C          ILO     - ILO contains information for efficient process-
   43.    C                    ing after the initial call, and ILO must not be
   44.    C                    changed by the user.  Distinct splines require
   45.    C                    distinct ILO parameters.
   46.    C          ILEFT   - largest integer satisfying XT(ILEFT) .LE. X
   47.    C          MFLAG   - signals when X lies out of bounds
   48.    C
   49.    C     Error Conditions
   50.    C         None
   51.    C***REFERENCES  C. DE BOOR, *PACKAGE FOR CALCULATING WITH B-SPLINES*,
   52.    C                 SIAM JOURNAL ON NUMERICAL ANALYSIS, VOLUME 14, NO. 3,
   53.    C                 JUNE 1977, PP. 441-472.
   54.    C***ROUTINES CALLED  (NONE)
   55.    C***END PROLOGUE  INTRV
   56.    C
   57.    C
   58.          INTEGER IHI, ILEFT, ILO, ISTEP, LXT, MFLAG, MIDDLE
   59.          REAL*8 X
   60.          REAL*8 XT(LXT)
   61.    C***FIRST EXECUTABLE STATEMENT  INTRV
   62.          IHI = ILO + 1
   63.          IF (IHI.LT.LXT) GO TO 10
   64.          IF (X.GE.XT(LXT)) GO TO 110
   65.          IF (LXT.LE.1) GO TO 90
   66.          ILO = LXT - 1
   67.          IHI = LXT
   68.    C
   69.       10 IF (X.GE.XT(IHI)) GO TO 40
   70.          IF (X.GE.XT(ILO)) GO TO 100
   71.    C
   72.    C *** NOW X .LT. XT(IHI) . FIND LOWER BOUND
   73.          ISTEP = 1
   74.       20 IHI = ILO
   75.          ILO = IHI - ISTEP
   76.          IF (ILO.LE.1) GO TO 30
   77.          IF (X.GE.XT(ILO)) GO TO 70
   78.          ISTEP = ISTEP*2
   79.          GO TO 20
   80.       30 ILO = 1
   81.          IF (X.LT.XT(1)) GO TO 90
   82.          GO TO 70
   83.    C *** NOW X .GE. XT(ILO) . FIND UPPER BOUND
   84.       40 ISTEP = 1
   85.       50 ILO = IHI
   86.          IHI = ILO + ISTEP
   87.          IF (IHI.GE.LXT) GO TO 60
   88.          IF (X.LT.XT(IHI)) GO TO 70
   89.          ISTEP = ISTEP*2
   90.          GO TO 50
   91.       60 IF (X.GE.XT(LXT)) GO TO 110
   92.          IHI = LXT
   93.    C
   94.    C *** NOW XT(ILO) .LE. X .LT. XT(IHI) . NARROW THE INTERVAL
   95.       70 MIDDLE = (ILO+IHI)/2
   96.          IF (MIDDLE.EQ.ILO) GO TO 100
   97.    C     NOTE. IT IS ASSUMED THAT MIDDLE = ILO IN CASE IHI = ILO+1
   98.          IF (X.LT.XT(MIDDLE)) GO TO 80
   99.          ILO = MIDDLE
  100.          GO TO 70
  101.       80 IHI = MIDDLE
  102.          GO TO 70
  103.    C *** SET OUTPUT AND RETURN
  104.       90 MFLAG = -1
  105.          ILEFT = 1
  106.          RETURN
  107.      100 MFLAG = 0
  108.          ILEFT = ILO
  109.          RETURN
  110.      110 MFLAG = 1
  111.          ILEFT = LXT
  112.          RETURN
  113.          END

